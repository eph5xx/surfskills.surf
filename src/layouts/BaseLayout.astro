---
import "@/styles/globals.css";
import PostHog from "@/components/PostHog.astro";
import PostHogIdentifyClient from "@/components/PostHogIdentifyClient.astro";
import { absoluteUrl } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Absolute URL; falls back to the site-wide 1200×630 share image. */
  ogImage?: string;
  ogType?: string;
}

const {
  title = "Surf Skills — AI agent skills directory, preview before using",
  description = "A categorized directory of open-source AI agent skills. Preview what each one does, then open the source in one click.",
  canonical = absoluteUrl(Astro.site!, Astro.url.pathname),
  noindex = false,
  jsonLd = [],
  ogImage = absoluteUrl(Astro.site!, "/og-default.png"),
  ogType = "website",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="surfskills.surf" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {
      jsonLd.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    <!-- Pre-paint auth check: pick the header CTA before first paint, no flash.
         ponytail: cookie-presence is a heuristic, not a validated session;
         upgrade path = SSR the page if the header ever needs exact session. -->
    <script is:inline>
      if (/-auth-token(\.\d+)?=/.test(document.cookie))
        document.documentElement.classList.add("is-authed");
      // Pre-paint JS marker: scroll-reveal styles apply only under html.js, so
      // with JS off nothing is ever stuck at opacity 0.
      document.documentElement.classList.add("js");
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Onest:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <PostHog />
    <PostHogIdentifyClient />
  </head>
  <body>
    <slot />
    <script>
      // PRODUCT.md: every animation needs a reduced-motion alternative — that
      // includes autoplaying demo loops. Halt them all and re-check live.
      const rm = window.matchMedia("(prefers-reduced-motion: reduce)");
      const applyMotionPreference = () => {
        if (!rm.matches) return;
        document.querySelectorAll<HTMLVideoElement>("video[autoplay]").forEach((v) => {
          v.pause();
        });
      };
      applyMotionPreference();
      rm.addEventListener("change", applyMotionPreference);

      // Catalog demo loops ([data-vis-play]) play only while on screen — a
      // 32-card grid must not decode 32 videos at once on a phone. Videos
      // keep `autoplay` for the pre-JS default; reduced motion always wins.
      const loops = document.querySelectorAll<HTMLVideoElement>("video[data-vis-play]");
      if (loops.length) {
        const vio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const v = e.target as HTMLVideoElement;
              if (e.isIntersecting && !rm.matches) v.play().catch(() => {});
              else v.pause();
            }
          },
          { rootMargin: "25% 0px" },
        );
        loops.forEach((v) => vio.observe(v));
      }

      // A demo mp4 that fails to load (CDN blip, pulled asset) must not leave a
      // blank box. Videos with a poster keep it; the rest swap to the shared
      // placeholder still. <source> errors don't bubble, so listen in capture.
      const swapFailedVideo = (v: HTMLVideoElement) => {
        if (v.hasAttribute("data-hero-video") || v.dataset.failed) return;
        v.dataset.failed = "1";
        if (v.poster) return;
        const img = document.createElement("img");
        img.src = "/skills/skill-placeholder.svg";
        img.alt = "";
        img.className = v.className;
        v.replaceWith(img);
      };
      document.addEventListener(
        "error",
        (e) => {
          const t = e.target;
          if (t instanceof HTMLSourceElement) {
            const v = t.closest("video");
            if (v) swapFailedVideo(v);
          }
        },
        true,
      );
      // Sources that already failed before this module ran (it's deferred).
      document.querySelectorAll<HTMLVideoElement>("video").forEach((v) => {
        if (v.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) swapFailedVideo(v);
      });
    </script>
  </body>
</html>
