---
import "@/styles/globals.css";
import CookieConsent from "@/components/CookieConsent.astro";
import PostHog from "@/components/PostHog.astro";
import PostHogIdentifyClient from "@/components/PostHogIdentifyClient.astro";
import { absoluteUrl } from "@/lib/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Absolute URL; falls back to the site-wide 1200×630 share image. */
  ogImage?: string;
  ogType?: string;
}

const {
  title = "Surf Skills — AI agent skills directory, preview before using",
  description = "A categorized directory of open-source AI agent skills. Preview what each one does, then open the source in one click.",
  canonical = absoluteUrl(Astro.site!, Astro.url.pathname),
  noindex = false,
  jsonLd = [],
  ogImage = absoluteUrl(Astro.site!, "/og-default.png"),
  ogType = "website",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="surfskills.surf" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {
      jsonLd.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    <!-- Pre-paint auth check: pick the header CTA before first paint, no flash.
         ponytail: cookie-presence is a heuristic, not a validated session;
         upgrade path = SSR the page if the header ever needs exact session. -->
    <script is:inline>
      if (/-auth-token(\.\d+)?=/.test(document.cookie))
        document.documentElement.classList.add("is-authed");
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Onest:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <PostHog />
    <PostHogIdentifyClient />
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>
