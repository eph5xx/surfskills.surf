---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostHogIdentify from "@/components/PostHogIdentify.astro";

export const prerender = false;

if (!Astro.locals.user) return Astro.redirect("/login?next=%2Faccount", 303);

const user = Astro.locals.user;

// /api/checkout bails out here with ?error=checkout when Polar can't start a
// session — surface it instead of silently landing on a normal account page.
const checkoutFailed = Astro.url.searchParams.get("error") === "checkout";
---

<BaseLayout title="Your account — Surf Skills" description="Manage your surfskills account." noindex>
  <PostHogIdentify userId={user.id} email={user.email} />
  <div class="mx-auto max-w-[1200px] px-8">
    <Header />

    <main id="content" class="flex justify-center py-16 md:py-24">
      <div class="w-full max-w-[560px]">
        <h1 class="text-[34px]">Your account</h1>
        <p class="mt-1.5 text-[15px] text-base-content/70 [overflow-wrap:anywhere]">{user.email ?? "Signed in"}</p>

        {
          checkoutFailed && (
            <div role="alert" class="alert alert-error alert-soft mt-5 text-[14px] font-semibold">
              <span>
                Checkout didn't start — nothing was charged. Give it another try
                in a moment.
              </span>
            </div>
          )
        }

        <div class="card mt-7 bg-base-100 shadow-md">
          <div class="card-body p-7 md:p-8">
            <h2 class="text-[22px]">Free account</h2>
            <p class="mt-2 text-[14.5px] leading-[1.6] text-base-content/70">
              Browse and download free skills from the library.
            </p>
            <a href="/discover" class="btn btn-primary btn-block mt-6">
              Browse skills
            </a>
          </div>
        </div>

        <form method="post" action="/api/auth/signout" class="mt-6 text-center">
          <button
            type="submit"
            class="link link-hover text-[14px] font-semibold text-base-content/60 hover:text-primary"
          >
            Sign out
          </button>
        </form>
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
