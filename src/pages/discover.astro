---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Directory from "@/components/discover/Directory.astro";
import Footer from "@/components/Footer.astro";
---

<BaseLayout
  title="Discover skills — the full lineup | surfskills.surf"
  description="Browse every open-source AI agent skill in the directory. Preview what each one does, then open the source in one click — works with Claude, ChatGPT, Cursor and more."
>
  <div id="top" class="mx-auto max-w-[1200px] px-5 md:px-8">
    <Header />

    <section class="pb-6 pt-12">
      <h1 class="text-[44px] leading-[1.05]">Skills available now</h1>
      <p class="mt-3 max-w-[560px] text-[16px] leading-[1.6] text-base-content/70">
        Every skill below is open source — preview what it does, then open the
        source in one click. More land each week.
      </p>
    </section>

    <Directory />
    <Footer />
  </div>
</BaseLayout>
