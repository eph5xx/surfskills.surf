---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Directory from "@/components/discover/Directory.astro";
import Footer from "@/components/Footer.astro";
import { loadDirectory } from "@/data/skill-model/db";
import { buildDirectoryItems, buildFacets } from "@/data/directory";

// Static: the catalog is a frozen build-time snapshot (content collections).
export const prerender = true;

const dir = await loadDirectory();
const items = buildDirectoryItems(dir.entries, dir.availableIds);
const facets = buildFacets(items);

// Honest social-proof stat: skills + distinct collections. Stars are per-collection,
// so summing them across skills would double-count — counts are the truthful axis.
const collectionCount = new Set(items.map((i) => i.collectionName)).size;
---

<BaseLayout
  title="Discover skills — the full lineup | Surf Skills"
  description="Browse every open-source AI agent skill in the directory. Preview what each one does, then open the source in one click — works with Claude, ChatGPT, Cursor and more."
>
  <div id="top" class="mx-auto max-w-[1200px] px-5 md:px-8">
    <Header />

    <section class="pb-6 pt-12">
      <h1 class="text-[44px] leading-[1.05]">Discover Skills</h1>

      {
        items.length > 0 && (
          <p class="mt-4 text-[14px] text-base-content/60">
            <span class="font-display font-semibold text-base-content">{items.length}</span>{" "}
            {items.length === 1 ? "skill" : "skills"} across{" "}
            <span class="font-display font-semibold text-base-content">{collectionCount}</span>{" "}
            open-source {collectionCount === 1 ? "collection" : "collections"}
          </p>
        )
      }
    </section>

    <Directory items={items} facets={facets} />
    <Footer />
  </div>
</BaseLayout>
