---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Problems from "@/components/Problems.astro";
import UseCases from "@/components/UseCases.astro";
import WhatIsIt from "@/components/WhatIsIt.astro";
import JoinBanner from "@/components/JoinBanner.astro";
import Footer from "@/components/Footer.astro";
import { absoluteUrl } from "@/lib/seo";
import { setCatalogCache } from "@/lib/cache";

// SSR so the response carries the shared public catalog cache header at the edge.
// Nothing on this page depends on the session or per-request data.
export const prerender = false;

setCatalogCache(Astro.response.headers);

const title = "Surf Skills — AI agent skills directory, preview before using";
const description =
  "Browse a categorized, open-source AI agent skills directory. Preview each skill before you use it — the curated alternative to noisy skill marketplaces.";
const siteUrl = absoluteUrl(Astro.site!, "/");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Surf Skills",
    alternateName: "surfskills.surf",
    url: siteUrl,
    description:
      "Curated open-source AI agent skills directory — preview what each skill does before you use it.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Surf Skills",
    alternateName: "surfskills.surf",
    url: siteUrl,
    logo: absoluteUrl(Astro.site!, "/logo.png"),
    email: "team@surfskills.surf",
    sameAs: [
      "https://github.com/eph5xx",
      "https://x.com/eph5xx",
      "https://www.linkedin.com/in/ephemeralsad/",
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div id="top" class="relative isolate mx-auto max-w-[1200px] px-8">
    <Header />
    <Hero />
    <Problems />
    <UseCases />
    <WhatIsIt />
    <JoinBanner />
    <Footer />
  </div>
</BaseLayout>
