---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

// Prerendered to a static 404.html so Cloudflare serves it for any unmatched route.
// SSR catalog misses (/s/** unknown ids) serve this same built asset through the ASSETS
// binding (see notFoundPage in lib/cache.ts) — Astro.rewrite can't reach a prerendered
// page from an on-demand route, so no SSR rendering happens here.
export const prerender = true;
---

<BaseLayout title="Lost at sea — Surf Skills" description="That page drifted away.">
  <div class="mx-auto max-w-[1200px] px-8">
    <Header />

    <main id="content" class="flex justify-center py-24 text-center">
      <div class="max-w-[480px]">
        <span class="font-display text-[88px] leading-none">404</span>
        <h1 class="mt-4 text-[28px]">Wiped out</h1>
        <p class="mt-3 text-[15.5px] leading-[1.6] text-base-content/70">
          That page drifted out past the lineup. The skills are all back on shore.
        </p>
        <a href="/discover" class="btn btn-primary btn-lg mt-8">Browse skills</a>
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
