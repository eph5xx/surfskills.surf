---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

// Prerendered to a static 404.html so Cloudflare Pages serves it for any unmatched route
// (e.g. an unknown /s/ skill path that getStaticPaths didn't emit). No SSR page rewrites
// here anymore, so on-demand rendering is no longer needed.
export const prerender = true;
---

<BaseLayout title="Lost at sea — surfskills.surf" description="That page drifted away.">
  <div class="mx-auto max-w-[1200px] px-8">
    <Header />

    <main class="flex justify-center py-24 text-center">
      <div class="max-w-[480px]">
        <span class="font-display text-[88px] leading-none">404</span>
        <h1 class="mt-4 text-[28px]">Wiped out</h1>
        <p class="mt-3 text-[15.5px] leading-[1.6] text-base-content/70">
          That page drifted out past the lineup. The skills are all back on shore.
        </p>
        <a href="/discover" class="btn btn-primary btn-lg mt-8">Browse skills</a>
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
