---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SkillPage from "@/components/skill/SkillPage.astro";
import { skills } from "@/data/skills";
import { skillDetails } from "@/data/skill-details";

// Dynamic route, no getStaticPaths — rendered on demand.
export const prerender = false;

const { slug } = Astro.params;
const content = skillDetails[slug!];
const skill = skills.find((s) => s.slug === slug);
if (!content || !skill) return Astro.rewrite("/404");

// One URL for every state — the download endpoint re-checks entitlement
// server-side, so the page itself renders the same for everyone.
const downloadHref = `/api/skills/${slug}/download`;

const title = `${skill.title} — verified AI skill, shown working | surfskills.surf`;
---

<BaseLayout title={title} description={content.tagline}>
  <div id="top" class="mx-auto max-w-[1200px] px-8">
    <Header />
  </div>
  <SkillPage skill={skill} content={content} downloadHref={downloadHref} />
  <div class="mx-auto max-w-[1200px] px-8">
    <Footer />
  </div>
</BaseLayout>
