---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SkillPage from "@/components/skill/SkillPage.astro";
import PostHogIdentify from "@/components/PostHogIdentify.astro";
import { directorySkillsBySlug, directoryCollectionsById } from "@/data/skill-model";
import { getSubscription } from "@/lib/subscription";

// Dynamic route, no getStaticPaths — rendered on demand.
export const prerender = false;

const { slug } = Astro.params;
const skill = slug ? directorySkillsBySlug[slug] : undefined;
const collection = skill ? directoryCollectionsById[skill.collection]?.collection : undefined;
if (!skill || !collection) return Astro.rewrite("/404");

const user = Astro.locals.user;
const sub = user ? await getSubscription(Astro.locals) : null;

const title = `${skill.name} — verified AI skill, shown working | surfskills.surf`;
---

<BaseLayout title={title} description={skill.description.short}>
  {
    user && (
      <PostHogIdentify
        userId={user.id}
        email={user.email}
        plan={sub?.plan ?? null}
        subscriptionStatus={sub?.status ?? null}
      />
    )
  }
  <div id="top" class="mx-auto max-w-[1200px] px-8">
    <Header />
  </div>
  <SkillPage skill={skill} collection={collection} />
  <div class="mx-auto max-w-[1200px] px-8">
    <Footer />
  </div>
</BaseLayout>
