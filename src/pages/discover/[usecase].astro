---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Directory from "@/components/discover/Directory.astro";
import Footer from "@/components/Footer.astro";
import { loadDirectory } from "@/data/skill-model/db";
import { buildDirectoryItems, buildFacets } from "@/data/directory";
import { SkillUseCase } from "@/data/skill-model/types";
import { USE_CASE_LABELS, useCaseFromSlug } from "@/data/skill-model";
import { absoluteUrl } from "@/lib/seo";
import { setCatalogCache, NO_STORE } from "@/lib/cache";

// SSR use-case landing pages: /discover/<slug> (design, video, seo, …). Crawlable,
// server-rendered, keyword-shaped pages — the SEO/GEO surface that the client-side
// /discover filters can't provide. Lives under /discover/ (not /skills/) because
// public/skills/ already serves demo MP4s. Reuses the Directory shell with items
// pre-filtered to one use case; the use_case facet is dropped (Kind/License remain).
export const prerender = false;

// Per-use-case copy — unique <title>/description/<h1>/intro for SEO + GEO.
const COPY: Record<SkillUseCase, { title: string; description: string; heading: string; intro: string }> = {
  [SkillUseCase.Design]: {
    title: "AI agent skills for design — UI, frontend & brand | surfskills.surf",
    description:
      "Open-source AI agent skills for design: UI/UX polish, taste-driven frontend, websites and brand systems. Preview what each does, then open the source in one click.",
    heading: "AI skills for design",
    intro:
      "Skills that help your agent design and build interfaces — taste-driven frontend, UI polish, websites and brand systems. Every one is open source: preview it here, then install in one click.",
  },
  [SkillUseCase.Video]: {
    title: "AI agent skills for video & motion | surfskills.surf",
    description:
      "Open-source AI agent skills for video and motion: render videos from a prompt, motion graphics, captions and explainers. Preview each, then open the source in one click.",
    heading: "AI skills for video",
    intro:
      "Skills that turn a prompt into rendered video — motion graphics, captions, product and explainer videos. Every one is open source: preview it here, then install in one click.",
  },
  [SkillUseCase.Images]: {
    title: "AI agent skills for image generation | surfskills.surf",
    description:
      "Open-source AI agent skills for generating imagery and illustrations. Preview what each one produces, then open the source in one click.",
    heading: "AI skills for images",
    intro:
      "Skills that generate static imagery and illustrations for your projects. Every one is open source: preview it here, then install in one click.",
  },
  [SkillUseCase.Writing]: {
    title: "AI agent skills for writing & content | surfskills.surf",
    description:
      "Open-source AI agent skills for writing and editing — content, copy and prose that doesn't read like a template. Preview each, then open the source in one click.",
    heading: "AI skills for writing",
    intro:
      "Skills that help your agent write and edit prose — content, copy and humanized text. Every one is open source: preview it here, then install in one click.",
  },
  [SkillUseCase.SEO]: {
    title: "AI agent skills for SEO & growth | surfskills.surf",
    description:
      "Open-source AI agent skills for SEO and growth: search optimization, content and marketing workflows. Preview each, then open the source in one click.",
    heading: "AI skills for SEO",
    intro:
      "Skills that help your agent with search optimization, content and growth. Every one is open source: preview it here, then install in one click.",
  },
  [SkillUseCase.Development]: {
    title: "AI agent skills for development | surfskills.surf",
    description:
      "Open-source AI agent skills for development: build and integrate code, wire up backends, APIs and infra. Preview each, then open the source in one click.",
    heading: "AI skills for development",
    intro:
      "Skills that help your agent build and integrate code — backends, APIs, SDKs and infrastructure. Every one is open source: preview it here, then install in one click.",
  },
  [SkillUseCase.Research]: {
    title: "AI agent skills for research & review | surfskills.surf",
    description:
      "Open-source AI agent skills for research and review: understand codebases, map knowledge, audit and score work. Preview each, then open the source in one click.",
    heading: "AI skills for research",
    intro:
      "Skills that help your agent research, understand and review — knowledge graphs, codebase maps, audits and scored reports. Every one is open source: preview it here, then install in one click.",
  },
};

const { usecase } = Astro.params;
const useCase = usecase ? useCaseFromSlug(usecase) : undefined;
// Unknown slug → real 404 (never cached). We return a bare 404 rather than
// rewriting to the prerendered /404 page: that rewrite is forbidden in Cloudflare
// `server` output (404.astro is intentionally prerendered for unmatched routes).
if (useCase === undefined) {
  return new Response("Not found", { status: 404, headers: { "Cache-Control": NO_STORE } });
}

const copy = COPY[useCase];
const label = USE_CASE_LABELS[useCase];

let items: ReturnType<typeof buildDirectoryItems> = [];
let facets: ReturnType<typeof buildFacets> = [];
try {
  const dir = await loadDirectory(Astro.locals.supabase);
  items = buildDirectoryItems(dir.entries, dir.availableIds).filter((i) =>
    i.useCases.includes(label),
  );
  // Refinement facets only — the use_case facet itself is fixed for this page.
  facets = buildFacets(items).filter((f) => f.key !== "use_case");
  setCatalogCache(Astro.response.headers);
} catch (err) {
  console.error(`[discover/${usecase}] failed to load catalog`, err);
  Astro.response.headers.set("Cache-Control", NO_STORE);
}

const pageUrl = absoluteUrl(Astro.site!, Astro.url.pathname);
const discoverUrl = absoluteUrl(Astro.site!, "/discover");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: copy.heading,
    description: copy.description,
    url: pageUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: items.map((item, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: absoluteUrl(Astro.site!, item.href),
      name: item.title,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "All skills", item: discoverUrl },
      { "@type": "ListItem", position: 2, name: copy.heading, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={copy.title} description={copy.description} jsonLd={jsonLd}>
  <div id="top" class="mx-auto max-w-[1200px] px-5 md:px-8">
    <Header />

    <section class="pb-6 pt-12">
      <a href="/discover" class="text-[14px] font-medium text-base-content/55 hover:text-primary">
        ← All skills
      </a>
      <h1 class="mt-3 text-[44px] leading-[1.05]">{copy.heading}</h1>
      <p class="mt-3 max-w-[560px] text-[16px] leading-[1.6] text-base-content/70">
        {copy.intro}
      </p>
    </section>

    <Directory items={items} facets={facets} />
    <Footer />
  </div>
</BaseLayout>
