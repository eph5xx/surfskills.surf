---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SkillPage from "@/components/skill/SkillPage.astro";
import { loadSkill } from "@/data/skill-model/db";
import { toSkillCard, type Skill } from "@/data/skill-card";
import { absoluteUrl } from "@/lib/seo";
import { setCatalogCache, notFoundPage, NO_STORE } from "@/lib/cache";

// SSR (was prerendered): one page per directory skill, read from Supabase per
// request and cached at the edge, so new skills get a page with no redeploy.
// Skills live under /s/ keyed by their full id ("owner/repo/skill", e.g.
// /s/greensock/gsap-skills/gsap-scrolltrigger); the skill segment may contain a
// colon (e.g. tweak:evaluate). The 2-segment collection route is distinct.
export const prerender = false;

const { owner, repo, skill: skillSlug } = Astro.params;
const id = `${owner}/${repo}/${skillSlug}`;

let loaded: Awaited<ReturnType<typeof loadSkill>>;
try {
  loaded = await loadSkill(Astro.locals.supabase, id);
} catch (err) {
  console.error(`[skill] failed to load "${id}"`, err);
  return new Response("Catalog temporarily unavailable", {
    status: 503,
    headers: { "Cache-Control": NO_STORE },
  });
}

if (!loaded) return await notFoundPage(Astro.locals);

const { skill, collection, related } = loaded;
setCatalogCache(Astro.response.headers);

const title = `${skill.name} — AI skill by ${collection.author.name} | Surf Skills`;

const relatedCards: Skill[] = related.map((r) => toSkillCard(r));

const skillUrl = absoluteUrl(Astro.site!, `/s/${skill.id}`);
const discoverUrl = absoluteUrl(Astro.site!, "/discover");
const collectionUrl = absoluteUrl(Astro.site!, `/s/${collection.id}`);

// schema.org license must be a URL; only emit it for plain SPDX ids.
const licenseUrl =
  collection.license && /^[A-Za-z0-9.+-]+$/.test(collection.license)
    ? `https://spdx.org/licenses/${collection.license}`
    : undefined;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: skill.name,
    description: skill.description.short,
    url: skillUrl,
    applicationCategory: "DeveloperApplication",
    author: {
      "@type": "Person",
      name: collection.author.name,
      url: collection.author.url,
    },
    // No aggregateRating: skills have no genuine ratings, so the software
    // rich result is out of reach; offers/dates/sameAs are for entity
    // understanding, and eligibility follows automatically if ratings exist.
    offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
    isAccessibleForFree: true,
    sameAs: [collection.repositoryURL, collection.websiteURL].filter(Boolean),
    ...(skill.previewImage && { image: skill.previewImage }),
    ...(skill.createdAt && { datePublished: skill.createdAt }),
    ...(collection.updatedAt && { dateModified: collection.updatedAt }),
    ...(licenseUrl && { license: licenseUrl }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "All skills", item: discoverUrl },
      { "@type": "ListItem", position: 2, name: collection.name, item: collectionUrl },
      { "@type": "ListItem", position: 3, name: skill.name, item: skillUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={skill.description.short}
  jsonLd={jsonLd}
  ogImage={skill.previewImage}
>
  <div id="top" class="mx-auto max-w-[1200px] px-5 md:px-8">
    <Header />
  </div>
  <SkillPage skill={skill} collection={collection} relatedSkills={relatedCards} />
  <Footer />
</BaseLayout>
