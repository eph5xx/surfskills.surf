---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SkillPage from "@/components/skill/SkillPage.astro";
import { directorySkills, directoryCollectionsById, directoryEntryBySkillId, resolveRelatedSkills } from "@/data/skill-model";
import type { Collection, DirectorySkill } from "@/data/skill-model/types";
import { skillsById, type Skill } from "@/data/skills";
import { absoluteUrl } from "@/lib/seo";

// Prerendered: one static page per directory skill. Skills live under the /s/ prefix keyed by
// their full id ("owner/repo/skill", e.g. /s/greensock/gsap-skills/gsap-scrolltrigger). The
// skill segment may contain a colon (e.g. tweak:evaluate). The 2-segment collection route
// under /s/ is distinct from this 3-segment skill route.
export const prerender = true;

export function getStaticPaths() {
  return directorySkills.flatMap((skill) => {
    const collection = directoryCollectionsById[skill.collection]?.collection;
    if (!collection) return [];
    const [owner, repo, ...rest] = skill.id.split("/");
    return [{ params: { owner, repo, skill: rest.join("/") }, props: { skill, collection } }];
  });
}

const { skill, collection } = Astro.props as { skill: DirectorySkill; collection: Collection };

const title = `${skill.name} — open-source AI skill by ${collection.author.name} | surfskills.surf`;

const entry = directoryEntryBySkillId[skill.id];
const relatedSkills = entry ? resolveRelatedSkills(entry.relatedSkillSlugs) : [];
const relatedCards = relatedSkills
  .map((r) => skillsById[r.id])
  .filter((s): s is Skill => Boolean(s));

const skillUrl = absoluteUrl(Astro.site!, `/s/${skill.id}`);
const discoverUrl = absoluteUrl(Astro.site!, "/discover");
const collectionUrl = absoluteUrl(Astro.site!, `/s/${collection.id}`);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: skill.name,
    description: skill.description.short,
    url: skillUrl,
    applicationCategory: "DeveloperApplication",
    author: {
      "@type": "Person",
      name: collection.author.name,
      url: collection.author.url,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "All skills", item: discoverUrl },
      { "@type": "ListItem", position: 2, name: collection.name, item: collectionUrl },
      { "@type": "ListItem", position: 3, name: skill.name, item: skillUrl },
    ],
  },
];
---

<BaseLayout title={title} description={skill.description.short} jsonLd={jsonLd}>
  <div id="top" class="mx-auto max-w-[1200px] px-5 md:px-8">
    <Header />
  </div>
  <SkillPage skill={skill} collection={collection} relatedSkills={relatedCards} />
  <Footer />
</BaseLayout>
