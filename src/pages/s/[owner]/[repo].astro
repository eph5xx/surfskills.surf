---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CollectionPage from "@/components/collection/CollectionPage.astro";
import PostHogIdentify from "@/components/PostHogIdentify.astro";
import { skills, type Skill } from "@/data/skills";
import { directoryCollectionsById } from "@/data/skill-model";
import { getSubscription } from "@/lib/subscription";

// Dynamic route, no getStaticPaths — rendered on demand. Collections live under the /s/
// prefix keyed by their full id ("owner/repo", e.g. /s/greensock/gsap-skills). The /s/
// prefix keeps the root namespace free for top-level pages (/blog, /pricing, …).
export const prerender = false;

const { owner, repo } = Astro.params;
const id = owner && repo ? `${owner}/${repo}` : undefined;
const entry = id ? directoryCollectionsById[id] : undefined;
if (!entry) return Astro.rewrite("/404");

const { collection } = entry;

const catalogById = new Map(skills.map((s) => [s.id, s]));
const rosterSkills: Skill[] = collection.skills
  .map((skillId) => {
    const indexed = catalogById.get(skillId);
    if (indexed) return indexed;
    const name = skillId.split("/").pop() ?? skillId;
    return {
      id: skillId,
      slug: name,
      title: name,
      blurb: "",
      category: "",
      tools: [],
      free: true,
      thumbLabel: "",
      verified: false,
      available: false,
      video: undefined,
    };
  })
  .sort((a, b) => Number(b.available) - Number(a.available));

const user = Astro.locals.user;
const sub = user ? await getSubscription(Astro.locals) : null;

const count = rosterSkills.length;
const title = `${collection.name} — ${count} AI skill${count === 1 ? "" : "s"} by ${collection.author.name} | surfskills.surf`;
---

<BaseLayout title={title} description={collection.shortDescription}>
  {
    user && (
      <PostHogIdentify
        userId={user.id}
        email={user.email}
        plan={sub?.plan ?? null}
        subscriptionStatus={sub?.status ?? null}
      />
    )
  }
  <div id="top" class="mx-auto max-w-[1200px] px-5 md:px-8">
    <Header />
  </div>
  <CollectionPage collection={collection} skills={rosterSkills} />
  <div class="mx-auto max-w-[1200px] px-8">
    <Footer />
  </div>
</BaseLayout>
