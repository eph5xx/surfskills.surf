---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CollectionPage from "@/components/collection/CollectionPage.astro";
import { loadCollection } from "@/data/skill-model/db";
import { buildDirectoryItems, type DirectoryItem } from "@/data/directory";
import { skillSlugFromId, type DirectoryEntry } from "@/data/skill-model";
import { absoluteUrl } from "@/lib/seo";
import { setCatalogCache, notFoundPage, NO_STORE } from "@/lib/cache";

// SSR (was prerendered): one page per directory collection, read from Supabase per
// request and cached at the edge. Collections live under /s/ keyed by their full id
// ("owner/repo", e.g. /s/greensock/gsap-skills). The 2-segment route here is
// distinct from the 3-segment skill route under /s/.
export const prerender = false;

const { owner, repo } = Astro.params;
const id = `${owner}/${repo}`;

let loaded: Awaited<ReturnType<typeof loadCollection>>;
try {
  loaded = await loadCollection(Astro.locals.supabase, id);
} catch (err) {
  console.error(`[collection] failed to load "${id}"`, err);
  return new Response("Catalog temporarily unavailable", {
    status: 503,
    headers: { "Cache-Control": NO_STORE },
  });
}

if (!loaded) return await notFoundPage(Astro.locals);

const { collection, skills: liveSkills } = loaded;
setCatalogCache(Astro.response.headers);

// Roster = every skill the repo ships, rendered as the same DirectoryCard the
// Discover grid and skill-page "Pairs well with" use. Live skills (we have a page)
// become clickable preview cards (poster + hover video); the rest render as greyed
// "coming soon" placeholders. Live ones sort first.
const liveIds = new Set(liveSkills.map((s) => s.id));
const liveEntries: DirectoryEntry[] = liveSkills.map((skill) => ({
  collection,
  skill,
  relatedSkillSlugs: [],
}));
const liveItems = buildDirectoryItems(liveEntries, liveIds);

const comingSoonItems: DirectoryItem[] = collection.skills
  .filter((skillId) => !liveIds.has(skillId))
  .map((skillId) => ({
    id: skillId,
    slug: skillSlugFromId(skillId),
    href: `/s/${skillId}`,
    title: skillId.split("/").pop() ?? skillId,
    blurb: "",
    useCases: [],
    kind: "",
    author: {
      name: collection.author.name,
      url: collection.author.url,
      avatarURL: collection.author.avatarURL,
    },
    collectionName: collection.name,
    githubStars: collection.githubStars,
    available: false,
  }));

const rosterItems: DirectoryItem[] = [...liveItems, ...comingSoonItems];

const title = `${collection.name} — AI agent skills | Surf Skills`;

const discoverUrl = absoluteUrl(Astro.site!, "/discover");
const collectionUrl = absoluteUrl(Astro.site!, `/s/${collection.id}`);

// Meta description: lead with the long-form body (first sentence) when present, so
// the SERP snippet is richer than the one-line summary; fall back to it otherwise.
const firstSentence = collection.longDescription?.trim().split(/(?<=[.!?])\s/)[0];
const metaDescription =
  firstSentence && firstSentence.length >= 40 ? firstSentence : collection.shortDescription;

// schema.org license must be a URL; only emit it for plain SPDX ids.
const licenseUrl =
  collection.license && /^[A-Za-z0-9.+-]+$/.test(collection.license)
    ? `https://spdx.org/licenses/${collection.license}`
    : undefined;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "All skills", item: discoverUrl },
      { "@type": "ListItem", position: 2, name: collection.name, item: collectionUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": collectionUrl,
    url: collectionUrl,
    name: collection.name,
    description: collection.shortDescription,
    isPartOf: { "@type": "WebSite", name: "Surf Skills", url: Astro.site!.origin },
    about: {
      "@type": "Organization",
      name: collection.author.name,
      url: collection.author.url,
    },
    ...(licenseUrl && { license: licenseUrl }),
    ...(collection.updatedAt && { dateModified: collection.updatedAt }),
    // ItemList of the live skills only (coming-soon roster tiles have no page to point at).
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: liveSkills.length,
      itemListElement: liveSkills.map((skill, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "SoftwareApplication",
          name: skill.name,
          applicationCategory: "DeveloperApplication",
          url: absoluteUrl(Astro.site!, `/s/${skill.id}`),
          description: skill.description.short,
          offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
        },
      })),
    },
  },
  // FAQPage — only when the collection has real Q&As, matching the on-page accordion.
  ...(collection.faq && collection.faq.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: collection.faq.map((item) => ({
            "@type": "Question",
            name: item.q,
            acceptedAnswer: { "@type": "Answer", text: item.a },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={title}
  description={metaDescription}
  jsonLd={jsonLd}
  ogImage={liveSkills.find((s) => s.previewImage)?.previewImage}
>
  <div id="top" class="mx-auto max-w-[1200px] px-5 md:px-8">
    <Header />
  </div>
  <CollectionPage collection={collection} items={rosterItems} />
  <div class="mx-auto max-w-[1200px] px-8">
    <Footer />
  </div>
</BaseLayout>
