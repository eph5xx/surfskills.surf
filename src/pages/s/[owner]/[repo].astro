---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CollectionPage from "@/components/collection/CollectionPage.astro";
import { loadCollection } from "@/data/skill-model/db";
import { toSkillCard, type Skill } from "@/data/skill-card";
import { absoluteUrl } from "@/lib/seo";
import { setCatalogCache, notFound, NO_STORE } from "@/lib/cache";

// SSR (was prerendered): one page per directory collection, read from Supabase per
// request and cached at the edge. Collections live under /s/ keyed by their full id
// ("owner/repo", e.g. /s/greensock/gsap-skills). The 2-segment route here is
// distinct from the 3-segment skill route under /s/.
export const prerender = false;

const { owner, repo } = Astro.params;
const id = `${owner}/${repo}`;

let loaded: Awaited<ReturnType<typeof loadCollection>>;
try {
  loaded = await loadCollection(Astro.locals.supabase, id);
} catch (err) {
  console.error(`[collection] failed to load "${id}"`, err);
  return new Response("Catalog temporarily unavailable", {
    status: 503,
    headers: { "Cache-Control": NO_STORE },
  });
}

if (!loaded) return notFound(await Astro.rewrite("/404"));

const { collection, skills: liveSkills } = loaded;
setCatalogCache(Astro.response.headers);

// Roster = every skill the repo ships. Live skills (we have a page) resolve to a
// full card; the rest render greyed "coming soon". Live ones sort first.
const liveById = new Map(liveSkills.map((s) => [s.id, toSkillCard(s, { available: true })]));
const rosterSkills: Skill[] = collection.skills
  .map((skillId) => {
    const live = liveById.get(skillId);
    if (live) return live;
    const name = skillId.split("/").pop() ?? skillId;
    return {
      id: skillId,
      slug: name,
      title: name,
      blurb: "",
      category: "",
      tools: [],
      free: true,
      thumbLabel: "",
      verified: false,
      available: false,
      video: undefined,
    } satisfies Skill;
  })
  .sort((a, b) => Number(b.available) - Number(a.available));

const count = rosterSkills.length;
const title = `${collection.name} — ${count} AI skill${count === 1 ? "" : "s"} by ${collection.author.name} | surfskills.surf`;

const discoverUrl = absoluteUrl(Astro.site!, "/discover");
const collectionUrl = absoluteUrl(Astro.site!, `/s/${collection.id}`);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "All skills", item: discoverUrl },
      { "@type": "ListItem", position: 2, name: collection.name, item: collectionUrl },
    ],
  },
];
---

<BaseLayout title={title} description={collection.shortDescription} jsonLd={jsonLd}>
  <div id="top" class="mx-auto max-w-[1200px] px-5 md:px-8">
    <Header />
  </div>
  <CollectionPage collection={collection} skills={rosterSkills} />
  <div class="mx-auto max-w-[1200px] px-8">
    <Footer />
  </div>
</BaseLayout>
