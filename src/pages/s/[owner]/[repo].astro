---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CollectionPage from "@/components/collection/CollectionPage.astro";
import { skills, type Skill } from "@/data/skills";
import { directoryCollections } from "@/data/skill-model";
import type { Collection } from "@/data/skill-model/types";
import { absoluteUrl } from "@/lib/seo";

// Prerendered: one static page per directory collection. Collections live under the /s/
// prefix keyed by their full id ("owner/repo", e.g. /s/greensock/gsap-skills). The /s/
// prefix keeps the root namespace free for top-level pages (/blog, /pricing, …).
export const prerender = true;

export function getStaticPaths() {
  return directoryCollections.map((collection) => {
    const [owner, repo] = collection.id.split("/");
    return { params: { owner, repo }, props: { collection } };
  });
}

const { collection } = Astro.props as { collection: Collection };

const catalogById = new Map(skills.map((s) => [s.id, s]));
const rosterSkills: Skill[] = collection.skills
  .map((skillId) => {
    const indexed = catalogById.get(skillId);
    if (indexed) return indexed;
    const name = skillId.split("/").pop() ?? skillId;
    return {
      id: skillId,
      slug: name,
      title: name,
      blurb: "",
      category: "",
      tools: [],
      free: true,
      thumbLabel: "",
      verified: false,
      available: false,
      video: undefined,
    };
  })
  .sort((a, b) => Number(b.available) - Number(a.available));

const count = rosterSkills.length;
const title = `${collection.name} — ${count} AI skill${count === 1 ? "" : "s"} by ${collection.author.name} | surfskills.surf`;

const discoverUrl = absoluteUrl(Astro.site!, "/discover");
const collectionUrl = absoluteUrl(Astro.site!, `/s/${collection.id}`);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "All skills", item: discoverUrl },
      { "@type": "ListItem", position: 2, name: collection.name, item: collectionUrl },
    ],
  },
];
---

<BaseLayout title={title} description={collection.shortDescription} jsonLd={jsonLd}>
  <div id="top" class="mx-auto max-w-[1200px] px-5 md:px-8">
    <Header />
  </div>
  <CollectionPage collection={collection} skills={rosterSkills} />
  <div class="mx-auto max-w-[1200px] px-8">
    <Footer />
  </div>
</BaseLayout>
