---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { sanitizeNext } from "@/lib/auth";

export const prerender = false;

const next = sanitizeNext(Astro.url.searchParams.get("next"));
if (Astro.locals.user) return Astro.redirect(next, 303);

const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error");

const errorCopy: Record<string, string> = {
  oauth: "That sign-in didn't go through. Give it another try.",
  email: "We couldn't send the link — check the address and try again.",
  expired: "That link has expired or was already used. Request a fresh one.",
  unknown: "Something went sideways. Try again.",
};
---

<BaseLayout title="Log in — surfskills.surf" description="Sign in to surfskills to unlock and download verified AI skills." noindex>
  <div class="mx-auto max-w-[1200px] px-8">
    <Header />

    <main class="flex justify-center py-16 md:py-24">
      <div class="w-full max-w-[440px]">
        <div class="card bg-base-100 shadow-md">
          <div class="card-body p-8 md:p-10">
          {
            sent ? (
              <div class="text-center">
                <span class="text-[44px] leading-none">📬</span>
                <h1 class="mt-4 text-[28px]">Check your inbox</h1>
                <p class="mt-3 text-[15px] leading-[1.6] text-base-content/70">
                  We sent you a sign-in link. Click it on this device and you'll
                  land right back here, signed in.
                </p>
                <a href="/login" class="link link-secondary mt-6 inline-block text-[14px] font-semibold">
                  Use a different email
                </a>
              </div>
            ) : (
              <>
                <h1 class="text-[28px]">Hop on</h1>
                <p class="mt-2 text-[15px] leading-[1.6] text-base-content/70">
                  One account, every verified skill.
                </p>

                {error && (
                  <div role="alert" class="alert alert-error alert-soft mt-4 text-[14px] font-semibold">
                    <span>{errorCopy[error] ?? errorCopy.unknown}</span>
                  </div>
                )}

                <div class="mt-6 flex flex-col gap-3">
                  <form method="post" action="/api/auth/signin">
                    <input type="hidden" name="provider" value="google" />
                    <input type="hidden" name="next" value={next} />
                    <button type="submit" class="btn btn-block">
                      <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
                        <path fill="#4285F4" d="M23.5 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.45a5.52 5.52 0 0 1-2.39 3.62v3h3.87c2.26-2.09 3.57-5.16 3.57-8.81Z" />
                        <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.91l-3.87-3c-1.07.72-2.45 1.15-4.07 1.15-3.13 0-5.78-2.11-6.73-4.96H1.29v3.1A12 12 0 0 0 12 24Z" />
                        <path fill="#FBBC05" d="M5.27 14.28a7.2 7.2 0 0 1 0-4.56v-3.1H1.29a12 12 0 0 0 0 10.76l3.98-3.1Z" />
                        <path fill="#EA4335" d="M12 4.76c1.76 0 3.34.6 4.59 1.8l3.43-3.44C17.95 1.19 15.23 0 12 0A12 12 0 0 0 1.29 6.62l3.98 3.1C6.22 6.87 8.87 4.76 12 4.76Z" />
                      </svg>
                      Continue with Google
                    </button>
                  </form>

                  <form method="post" action="/api/auth/signin">
                    <input type="hidden" name="provider" value="github" />
                    <input type="hidden" name="next" value={next} />
                    <button type="submit" class="btn btn-block">
                      <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
                        <path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3Z" />
                      </svg>
                      Continue with GitHub
                    </button>
                  </form>
                </div>

                <div class="divider my-6 text-[12px] font-bold uppercase tracking-[0.12em] text-base-content/70">
                  or
                </div>

                <form method="post" action="/api/auth/signin">
                  <fieldset class="fieldset">
                    <legend class="fieldset-legend text-[13.5px]">Email magic link</legend>
                    <input type="hidden" name="provider" value="email" />
                    <input type="hidden" name="next" value={next} />
                    <input
                      id="email"
                      type="email"
                      name="email"
                      required
                      autocomplete="email"
                      placeholder="you@example.com"
                      class="input w-full"
                    />
                    <button type="submit" class="btn btn-primary btn-block mt-2">
                      Send me a sign-in link
                    </button>
                  </fieldset>
                </form>

                <p class="mt-5 text-center text-[12.5px] leading-[1.5] text-base-content/70">
                  No password to remember. New here? Any of these creates your
                  account.
                </p>
              </>
            )
          }
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
