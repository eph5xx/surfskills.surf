---
// "What it is / how it works" — B+C hybrid bento.
// Row 1: a wide dark panel that DEFINES an agent skill (grounded in Anthropic's
// docs, with an outbound link) + a light tile showing the AI tools it runs in
// with real brand logos. Row 2: the 3-step workflow as a light pipeline.
//
// No floating heading/paragraph above the grid — the tiles carry the meaning.
// Stays on the page's base-200 sand (NO full-bleed band) so it reads as a
// distinct block from SkillShowcase below, which uses a full-bleed bg-base-100.

// The AI tools shown as a curated logo wall (not per-skill compatibility —
// that lives on each skill detail page). Claude Code is omitted: its mark is
// byte-identical to Claude's and would read as a duplicate without text.
const tools = [
  { name: "Claude", src: "/logos/claude.svg" },
  { name: "ChatGPT", src: "/logos/openai.svg" },
  { name: "Cursor", src: "/logos/cursor.svg" },
  { name: "Gemini", src: "/logos/gemini.svg" },
  { name: "GitHub Copilot", src: "/logos/copilot.svg" },
  { name: "Replit", src: "/logos/replit.svg" },
  { name: "Windsurf", src: "/logos/windsurf.svg" },
  { name: "Lovable", src: "/logos/lovable.svg" },
  { name: "VS Code", src: "/logos/vscode.svg" },
  { name: "Factory", src: "/logos/factory.svg" },
  { name: "Zed", src: "/logos/zed.svg" },
  { name: "Tabnine", src: "/logos/tabnine.svg" },
];

// Each step shows a short, muted, looping demo clip (rendered with HyperFrames,
// brand-matched to the goldenhour theme; sources in media/how-it-works/) instead
// of a paragraph, so the workflow is visible at a glance. Clips live in
// /public/how and play only while on screen (see the script at the bottom); the
// poster still carries the frame for reduced-motion / pre-load.
const steps = [
  {
    n: "1",
    title: "Find the right skill",
    caption: "Browse the library and preview each skill's demo before you run it.",
    video: "/how/step-1-discover.mp4",
    poster: "/how/step-1-discover.jpg",
  },
  {
    n: "2",
    title: "Paste it into your AI tool",
    caption: "Copy the one-line install command into the AI tool you already use.",
    video: "/how/step-2-paste.mp4",
    poster: "/how/step-2-paste.jpg",
  },
  {
    n: "3",
    title: "Get the result",
    caption: "Your input goes in, and a clear, ready-to-use outcome comes back.",
    video: "/how/step-3-result.mp4",
    poster: "/how/step-3-result.jpg",
  },
];
---

<section id="how" data-wii class="mt-28 scroll-mt-24 md:mt-40">
  <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
    <!-- ============ TILE 1 — what an agent skill is (warm anchor, 2 cols) ============
         The audience is people intimidated by dev tools, so the "what's inside"
         panel is plain words on sand — no terminal frame, no monospace. -->
    <article
      class="reveal card card-border border-base-300 bg-base-100 shadow-sm md:col-span-2"
      style="--i:0"
    >
      <div class="card-body gap-6 p-7 md:p-8">
        <div>
          <h2 class="text-[28px] leading-tight md:text-[31px]">What is a skill?</h2>
          <p class="mt-3 max-w-[560px] text-[15px] leading-[1.6] text-base-content/75">
            An <a
              href="https://agentskills.io/home"
              target="_blank"
              rel="noopener"
              class="font-semibold text-secondary underline decoration-secondary/40 underline-offset-2 transition hover:decoration-secondary"
              >agent skill</a
            > is a small add-on that gives your AI a new ability. At its core it's just a
            <span class="font-semibold text-base-content">folder with files</span> — everything
            for one job, in one place.
          </p>
        </div>

        <!-- a skill is just a folder: one required page, the rest optional -->
        <div class="rounded-field border border-base-300 bg-base-200/60">
          <h3 class="flex items-center gap-2.5 border-b border-base-300 px-4 py-2.5 text-[13.5px] font-semibold text-base-content/70">
            <svg viewBox="0 0 24 24" class="size-4 text-base-content/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"></path>
            </svg>
            Inside one skill folder
          </h3>
          <ul class="grid gap-x-8 gap-y-4 px-4 py-4 sm:grid-cols-2">
            <li class="flex items-start gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-base-content/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                <path d="M15 2v5h5M10 12h6M10 16h6M8 12h.01M8 16h.01"></path>
              </svg>
              <span class="text-[13.5px] leading-[1.5] text-base-content/70">
                <strong class="font-semibold text-base-content">The instructions</strong> — one page
                telling the AI what to do. The only part every skill needs.
              </span>
            </li>
            <li class="flex items-start gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-base-content/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
              <span class="text-[13.5px] leading-[1.5] text-base-content/70">
                <strong class="font-semibold text-base-content">Helper tools</strong> — optional,
                ready-made helpers for the fiddly steps.
              </span>
            </li>
            <li class="flex items-start gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-base-content/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
              <span class="text-[13.5px] leading-[1.5] text-base-content/70">
                <strong class="font-semibold text-base-content">Reference notes</strong> — optional
                background the AI reads when it needs it.
              </span>
            </li>
            <li class="flex items-start gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-base-content/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
              </svg>
              <span class="text-[13.5px] leading-[1.5] text-base-content/70">
                <strong class="font-semibold text-base-content">Templates and examples</strong> —
                optional starting points the skill reuses.
              </span>
            </li>
          </ul>
        </div>

      </div>
    </article>

    <!-- ============ TILE 2 — runs in the AI you already use (light, 1 col) ============ -->
    <article
      class="reveal card card-border border-secondary-content/15 bg-secondary text-secondary-content shadow-sm"
      style="--i:1"
    >
      <div class="card-body gap-5 p-7 md:p-8">
        <div>
          <h2 class="text-[28px] leading-tight md:text-[31px]">Use the AI you have</h2>
          <p class="mt-3 text-[15px] leading-[1.6] text-secondary-content/75">
            Skills plug into the tools you already pay for — no new app, no migration.
            Install once and they just work.
          </p>
        </div>

        <!-- label-free logo wall: light tiles so the marks (some near-black) stay
             legible on teal; names live in alt/title for a11y + hover -->
        <ul class="mt-auto grid grid-cols-3 gap-2 sm:grid-cols-4">
          {
            tools.map((t) => (
              <li
                title={t.name}
                class="grid aspect-[5/3] place-items-center rounded-field border border-base-300 bg-base-100"
              >
                <img src={t.src} alt={t.name} loading="lazy" class="h-6 w-auto" />
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <!-- ============ ROW 2 — three-step pipeline (light cards, each shows its artifact) ============ -->
    {
      steps.map((step, i) => (
        <article
          class:list={[
            "reveal step-card card card-border relative border-base-300 bg-base-100 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md",
            i > 0 &&
              "md:before:pointer-events-none md:before:absolute md:before:-left-[10px] md:before:top-1/2 md:before:-translate-x-1/2 md:before:-translate-y-1/2 md:before:text-[20px] md:before:font-semibold md:before:leading-none md:before:text-base-content/30 md:before:content-['→']",
          ]}
          style={`--i:${i + 2}`}
        >
          <div class="card-body gap-3 p-6 md:p-7">
            <div class="flex items-center gap-3">
              {/* plum ink, not sand: sand on sienna is 3.2:1 at this size */}
              <span class="grid size-8 shrink-0 place-items-center rounded-field bg-primary font-display text-[18px] leading-none text-plum">
                {step.n}
              </span>
              <h3 class="text-[19px] leading-snug">{step.title}</h3>
            </div>

            {/* the artifact — a brand-rendered demo loop (16:10, matches the
               clip's native canvas). Decorative; screen readers get title +
               caption. Plays only while on screen — see the script below. */}
            <div
              class="aspect-[16/10] overflow-hidden rounded-field border border-base-300 bg-base-200/60"
              aria-hidden="true"
            >
              <video
                class="size-full object-cover"
                muted
                loop
                playsinline
                preload="none"
                poster={step.poster}
                data-how-video
              >
                <source src={step.video} type="video/mp4" />
              </video>
            </div>

            <p class="text-[13.5px] leading-[1.45] text-base-content/65">{step.caption}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* Scroll-in reveal: tiles fade + rise, staggered by --i. JS toggles .is-in on
     the [data-wii] root. Gated on html.js (set pre-paint in BaseLayout) so the
     section is never stuck at opacity 0 when scripts don't run. */
  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(html.js) .is-in .reveal {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.07s * var(--i, 0));
  }
  /* keep the hover-lift independent of the reveal transition */
  .step-card {
    transition-property: transform, box-shadow;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .step-card {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Scoped to the unique [data-wii] root. Threshold 0, not a fraction: the
  // section is taller than short (landscape) viewports, so a fractional
  // threshold can never be met there. The timer reveals it in environments
  // that never scroll (headless captures, search-engine renderers).
  const root = document.querySelector("[data-wii]");
  if (root) {
    const reveal = () => {
      root.classList.add("is-in");
      io.disconnect();
      clearTimeout(fallback);
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) reveal();
      },
      { threshold: 0 },
    );
    io.observe(root);
    const fallback = setTimeout(reveal, 3000);
  }

  // Each step's demo loop plays only while on screen (so three off-screen videos
  // never decode at once) and stays on its poster frame when reduced motion is
  // preferred. preload="none" defers the download until the first play().
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!prefersReduced) {
    const vio = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.25 },
    );
    document.querySelectorAll("[data-how-video]").forEach((v) => vio.observe(v));
  }
</script>
