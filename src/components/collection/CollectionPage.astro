---
import type { Collection } from "@/data/skill-model/types";
import DirectoryCard from "@/components/discover/DirectoryCard.astro";
import { formatUpdatedFull, type DirectoryItem } from "@/data/directory";

// Collection landing page — minimal hero (author, name, description, inline meta),
// install card, and roster grid.
interface Props {
  collection: Collection;
  items: DirectoryItem[];
}

const { collection, items } = Astro.props;

const ghHandle = (() => {
  try {
    return new URL(collection.author.url).pathname.replace(/^\/+/, "") || collection.author.name;
  } catch {
    return collection.author.name;
  }
})();

const compact = (n: number) =>
  new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 })
    .format(n)
    .toLowerCase();

const linkRows = [
  { href: collection.repositoryURL, label: "Open in GitHub", icon: "github" as const },
  ...(collection.websiteURL
    ? [{ href: collection.websiteURL, label: "Open website", icon: "globe" as const }]
    : []),
];

// Trust line under the install CTA — mirrors the skill page. "Open source" shows
// whenever the collection has a public repo (directory collections always do).
const trustParts = [
  "Free",
  ...(collection.repositoryURL ? ["Open source"] : []),
  "Works in Claude, Cursor, Codex & more",
];

// SEO content sections — mirror SkillPage: render each only when authored, so
// sparse collections stay hero + roster. "What it does" splits on blank lines.
const paragraphs = (collection.longDescription ?? "")
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);
const whenToUse = collection.whenToUse ?? [];
const faq = collection.faq ?? [];

const hasWhat = paragraphs.length > 0;
const hasWhen = whenToUse.length > 0;
const hasFaq = faq.length > 0;
const bothCols = hasWhat && hasWhen;
const updatedLabel = formatUpdatedFull(collection.updatedAt);
---

<div class="bg-base-200">
  <main class="mx-auto max-w-[1200px] px-5 pt-10 pb-20 md:px-8 md:pt-[42px]">
    <!-- Breadcrumb -->
    <nav class="breadcrumbs mb-7 text-[13.5px] font-semibold">
      <ul>
        <li><a href="/discover" class="text-secondary hover:text-primary">All skills</a></li>
        <li>{collection.name}</li>
      </ul>
    </nav>

    <!-- HERO -->
    <section
      class="relative overflow-hidden rounded-[1.6rem] px-7 py-9 text-primary-content shadow-[0_1px_2px_rgba(42,44,65,0.04),0_22px_46px_-32px_rgba(42,44,65,0.5)] md:px-12 md:py-12"
      style="background: linear-gradient(135deg, #dd6b4d 0%, #d4583a 52%, #c44a2d 100%)"
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(120% 90% at 88% -10%, rgba(242,177,52,.34) 0%, transparent 55%), radial-gradient(90% 70% at -8% 110%, rgba(28,26,40,.20) 0%, transparent 60%)"
      >
      </div>

      <div class="relative z-10 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_minmax(320px,360px)]">
        <!-- LEFT: identity, tagline, inline meta -->
        <div class="flex min-w-0 flex-col">
          <a
            href={collection.author.url}
            target="_blank"
            rel="noopener"
            class="flex w-fit items-center gap-3 rounded-full bg-black/15 py-1.5 pr-4 pl-1.5 backdrop-blur-sm"
          >
            {
              collection.author.avatarURL && (
                <img
                  src={collection.author.avatarURL}
                  alt=""
                  loading="lazy"
                  class="size-8 rounded-full ring-2 ring-primary-content/40"
                />
              )
            }
            <span class="text-[13.5px] font-semibold leading-tight">
              {collection.author.name}
              <span class="font-normal text-primary-content/80">· @{ghHandle} ↗</span>
            </span>
          </a>

          <h1 class="mt-6 font-display text-[40px] font-semibold leading-[0.98] tracking-[-0.035em] md:text-[60px]">
            {collection.name}
          </h1>

          <p class="mt-5 max-w-[52ch] text-[17px] font-medium leading-[1.5] text-primary-content/90 md:text-[19px]">
            {collection.shortDescription}
          </p>

          <div class="mt-5 flex flex-wrap items-center gap-2 text-[13px] font-semibold text-primary-content/85">
            {
              collection.githubStars !== undefined && (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-black/15 px-3 py-1">
                  <svg viewBox="0 0 16 16" class="size-[14px] opacity-80" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.6 0 0 3.6 0 8c0 3.5 2.3 6.5 5.5 7.6.4.1.5-.2.5-.4v-1.4c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-3.9 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.5 1.1.2 1.9.1 2.1.5.5.8 1.2.8 2.1 0 3-1.8 3.7-3.6 3.9.3.3.6.8.6 1.6v2.4c0 .2.1.5.6.4A8 8 0 0 0 16 8c0-4.4-3.6-8-8-8z" />
                  </svg>
                  {compact(collection.githubStars)} stars
                </span>
              )
            }
            {
              updatedLabel && (
                <span class="rounded-full bg-black/15 px-3 py-1">Updated {updatedLabel}</span>
              )
            }
            {
              collection.license && (
                <span class="rounded-full bg-black/15 px-3 py-1">{collection.license}</span>
              )
            }
            <span class="rounded-full bg-black/15 px-3 py-1">
              {items.length} {items.length === 1 ? "skill" : "skills"}
            </span>
          </div>
        </div>

        <!-- RIGHT: install card -->
        <aside class="flex flex-col">
          <div class="flex h-full flex-col rounded-[1.25rem] bg-base-100 p-6 text-base-content shadow-[0_1px_2px_rgba(42,44,65,0.04),0_22px_46px_-32px_rgba(42,44,65,0.5)]">
            <div class="flex items-center gap-2 rounded-xl border border-base-300 bg-base-200/60 px-3.5 py-3">
              <code
                title={collection.installCommand}
                class="min-w-0 flex-1 truncate font-mono text-[12.5px] leading-[1.6] text-base-content/75"
                >{collection.installCommand}</code
              >
              <button
                type="button"
                data-copy-cmd
                data-copy={collection.installCommand}
                aria-label="Copy install command"
                class="swap swap-rotate shrink-0 text-base-content/45 transition-colors hover:text-primary"
              >
                <svg class="swap-off size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="9" width="11" height="11" rx="2" />
                  <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                </svg>
                <svg class="swap-on size-[15px] text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </button>
            </div>

            <button
              type="button"
              data-paste-cta
              data-copy={collection.installCommand}
              class="btn btn-primary mt-3.5 h-12 min-h-0 w-full gap-2 rounded-[13px] text-[15.5px] font-semibold normal-case shadow-none"
            >
              <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" />
              </svg>
              <span data-paste-label>Paste into your agent</span>
            </button>
            <p class="mt-3 flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-center text-[12.5px] text-base-content/70">
              {
                trustParts.map((part, i) => (
                  <>
                    {i > 0 && (
                      <span class="text-base-content/30" aria-hidden="true">
                        ·
                      </span>
                    )}
                    <span class:list={[part === "Free" && "font-semibold text-[#4a6631]"]}>{part}</span>
                  </>
                ))
              }
            </p>

            <hr class="my-5 border-base-300" />

            <ul class="divide-y divide-base-300">
              {
                linkRows.map((row) => (
                  <li>
                    <a
                      href={row.href}
                      target="_blank"
                      rel="noopener"
                      class="group flex items-center justify-between py-2.5 text-[14px] font-semibold"
                    >
                      <span class="flex items-center gap-2.5 text-base-content/85 group-hover:text-primary">
                        {row.icon === "github" && (
                          <svg viewBox="0 0 16 16" class="size-[16px] text-base-content/50 group-hover:text-primary" fill="currentColor" aria-hidden="true">
                            <path d="M8 0C3.6 0 0 3.6 0 8c0 3.5 2.3 6.5 5.5 7.6.4.1.5-.2.5-.4v-1.4c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-3.9 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.5 1.1.2 1.9.1 2.1.5.5.8 1.2.8 2.1 0 3-1.8 3.7-3.6 3.9.3.3.6.8.6 1.6v2.4c0 .2.1.5.6.4A8 8 0 0 0 16 8c0-4.4-3.6-8-8-8z" />
                          </svg>
                        )}
                        {row.icon === "globe" && (
                          <svg viewBox="0 0 24 24" class="size-[16px] text-base-content/50 group-hover:text-primary" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M3 12h18" />
                            <path d="M12 3c2.5 2.5 2.5 15.5 0 18M12 3c-2.5 2.5-2.5 15.5 0 18" />
                          </svg>
                        )}
                        {row.label}
                      </span>
                      <span class="text-base-content/30 transition group-hover:text-primary">↗</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <!-- ROSTER -->
    <section class="mt-14">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-[28px] font-semibold tracking-[-0.025em] md:text-[34px]">
            The roster
          </h2>
        </div>
        <span class="hidden shrink-0 rounded-full bg-primary px-4 py-2 text-[13px] font-semibold text-primary-content sm:inline-block">
          {items.length} {items.length === 1 ? "skill" : "skills"}
        </span>
      </div>

      <!-- Same DirectoryCard + YouTube-style hover preview as Discover / "Pairs well
           with": [data-dir-list][data-view=grid] triggers the card's grid styles,
           initHoverVideo (below) drives poster↔video crossfade. -->
      <div
        data-roster-previews
        data-dir-list
        data-view="grid"
        class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
      >
        {items.map((item) => <DirectoryCard item={item} />)}
      </div>
    </section>

    <!-- SEO content: What it does / When to use it / FAQ — the whole card renders
         only once any of the three is authored (sparse collections stay hero + roster). -->
    {
      (hasWhat || hasWhen || hasFaq) && (
        <section class="mt-14">
          <div class="rounded-[20px] border border-base-300 bg-base-100 px-6 py-[26px] shadow-[0_1px_2px_rgba(42,44,65,0.04),0_18px_40px_-34px_rgba(42,44,65,0.45)] md:px-10 md:py-[34px]">
            {(hasWhat || hasWhen) && (
              <div class={`grid gap-8 ${bothCols ? "md:grid-cols-2 md:gap-0" : ""}`}>
                {hasWhat && (
                  <div class={bothCols ? "md:border-r md:border-base-300 md:pr-11" : ""}>
                    <h2 class="font-display text-[22px] tracking-[-0.02em]">
                      What it does
                    </h2>
                    <div class="mt-4 flex flex-col gap-[13px]">
                      {paragraphs.map((p) => (
                        <p class="max-w-[52ch] text-[16px] leading-[1.62] text-base-content/80 text-pretty">
                          {p}
                        </p>
                      ))}
                    </div>
                  </div>
                )}
                {hasWhen && (
                  <div class={bothCols ? "md:pl-11" : ""}>
                    <h2 class="font-display text-[22px] tracking-[-0.02em]">When to use it</h2>
                    <ul class="mt-4 flex flex-col gap-3.5">
                      {whenToUse.map((item) => (
                        <li class="flex gap-3">
                          <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-md bg-success/15">
                            <svg
                              viewBox="0 0 24 24"
                              class="size-3 text-success"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="3"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                            >
                              <path d="M20 6 9 17l-5-5" />
                            </svg>
                          </span>
                          <span>
                            <b class="font-display text-[15.5px] font-semibold">{item.title}</b>
                            <p class="mt-0.5 text-[14.5px] leading-[1.5] text-base-content/72 text-pretty">
                              {item.body}
                            </p>
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}

            {(hasWhat || hasWhen) && hasFaq && <hr class="my-8 border-base-300 md:my-9" />}

            {hasFaq && (
              <div class="mx-auto max-w-[620px]">
                <h2 class="font-display text-[22px] tracking-[-0.02em]">Common questions</h2>
                <div class="mt-4 border-t border-base-content/12">
                  {faq.map((item) => (
                    <details class="group border-b border-base-content/12">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-md py-[18px] font-display text-[16.5px] font-semibold outline-none focus-visible:ring-2 focus-visible:ring-primary/50 [&::-webkit-details-marker]:hidden">
                        {item.q}
                        <svg
                          viewBox="0 0 24 24"
                          class="size-[18px] shrink-0 text-primary transition-transform duration-200 group-open:rotate-180"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </summary>
                      <p class="max-w-[68ch] pb-5 text-[15px] leading-[1.6] text-base-content/72 text-pretty">
                        {item.a}
                      </p>
                    </details>
                  ))}
                </div>
              </div>
            )}
          </div>
        </section>
      )
    }
  </main>
</div>

<script>
  // Copy buttons ([data-copy-cmd] / [data-paste-cta]) with a global "Copied!"
  // toast and robust clipboard fallback. Shared with the skill pages.
  import "@/scripts/copy-feedback";
  // YouTube-style hover/in-view previews for the roster cards — same as Discover
  // and the skill page's "Pairs well with".
  import { initHoverVideo } from "@/scripts/hover-video";
  initHoverVideo("[data-roster-previews]");
</script>
