---
import { skills as allSkills, type Skill } from "@/data/skills";
import SkillSpotlight from "./SkillSpotlight.astro";
import SkillCard from "./SkillCard.astro";

// Home-page "examples" bento. The first skill with available + video gets the
// large spotlight card; every other skill renders as a SkillCard (live ones
// clickable, the rest greyed "coming soon").
interface Props {
  heading?: string;
}

const { heading = "What can you do with it?" } = Astro.props;

const live = allSkills.find((s) => s.available && s.video);
const rest: Skill[] = allSkills.filter((s) => s !== live);

// Landing-only copy: the coming-soon cards show real names/blurbs here while the
// Discover catalog keeps the editable "New Skill …" templates. Data stays one source.
const landingCopy: Record<string, { title: string; blurb: string }> = {
  "deep-market-research": { title: "Deep Market Research", blurb: "Name a space, get a sourced map: players, gaps, where it's growing." },
  "cold-email-engine": { title: "Cold Email Engine", blurb: "Your offer and list in, a sequence out that doesn't read like a bot wrote it." },
  "pitch-deck-narrative": { title: "Pitch Deck Narrative", blurb: "Messy founder brain in, a tight slide-by-slide story arc out — ready to design." },
};
---

<!-- Solid surface band (full-bleed) so the section reads as "inside". -->
<section
  id="skills"
  class="relative mt-[72px] scroll-mt-24 py-16 before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:bg-base-100"
>
  <div class="mb-[26px]">
    <h2 class="text-[34px]">{heading}</h2>
    <p class="mt-3 text-[16px] leading-[1.6] text-base-content/70">
      Drop a skill into your AI tool, hand it plain input, and it returns a
      finished, reviewed deliverable — like the live one below.
    </p>
  </div>

  {
    live ? (
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3 md:auto-rows-[minmax(0,1fr)]">
        <SkillSpotlight
          title={live.title}
          blurb={live.blurb}
          video={live.video!}
          ctaLabel="See it run →"
          ctaHref={`/skills/${live.slug}/`}
          class="md:col-span-2 md:row-span-2"
        />

        {rest.map((s) => <SkillCard skill={{ ...s, ...landingCopy[s.slug] }} />)}
      </div>
    ) : (
      <p class="py-12 text-center text-[16px] text-base-content/60">
        New skills land here soon — check back.
      </p>
    )
  }

  <div class="mt-10 text-center">
    <a href="/discover" class="btn btn-lg">Browse the full lineup →</a>
  </div>
</section>
