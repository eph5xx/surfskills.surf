---
interface Props {
  userId: string;
  email?: string | null;
  plan?: string | null;
  subscriptionStatus?: string | null;
}

const { userId, email, plan, subscriptionStatus } = Astro.props;

const personProps: Record<string, string> = {};
if (email) personProps.email = email;
if (plan) personProps.plan = plan;
if (subscriptionStatus) personProps.subscription_status = subscriptionStatus;
---

<script is:inline define:vars={{ userId, personProps }}>
  if (window.posthog) {
    posthog.identify(userId, personProps);
  } else {
    document.addEventListener(
      "DOMContentLoaded",
      function () {
        if (window.posthog) posthog.identify(userId, personProps);
      },
      { once: true },
    );
  }
</script>
