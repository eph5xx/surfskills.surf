---
import Logo from "./Logo.astro";

const productLinks = [
  { label: "Terms of Service", href: "/terms" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Cookies Policy", href: "/cookies" },
];
---

<footer class="relative left-1/2 mt-6 w-screen -translate-x-1/2 border-t border-base-300 bg-base-100/70 backdrop-blur">
  <div class="mx-auto max-w-[1200px] px-8 py-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <aside>
        <Logo />
      </aside>

      <nav class="flex flex-wrap gap-x-6 gap-y-3 text-[14.5px] font-medium">
        {
          productLinks.map((link) => (
            <a href={link.href} class="link link-hover text-[14.5px] text-base-content/70 hover:text-primary">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-base-300 pt-5 text-[13.5px] text-base-content/60 sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© 2026 surfskills.surf</span>
      <span class="text-base-content/50">Bring the mess. Catch the finished thing.</span>
    </div>
  </div>
</footer>
