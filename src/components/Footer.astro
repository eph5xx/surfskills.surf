---
import Logo from "./Logo.astro";

const productLinks = [
  { label: "Terms of Service", href: "/terms" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Cookies Policy", href: "/cookies" },
];

const socialLinks = [
  { label: "Email",    href: "mailto:team@surfskills.surf" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/ephemeralsad/" },
  { label: "Twitter",  href: "https://x.com/eph5xx" },
  { label: "GitHub",   href: "https://github.com/eph5xx" },
];
---

<footer class="relative left-1/2 mt-6 w-screen -translate-x-1/2 border-t border-base-300 bg-base-100/70 backdrop-blur">
  <div class="mx-auto max-w-[1200px] px-8 py-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <aside>
        <Logo />
      </aside>

      <nav class="flex flex-wrap gap-x-6 gap-y-3 text-[14.5px] font-medium">
        {
          productLinks.map((link) => (
            <a href={link.href} class="link link-hover rounded text-[14.5px] text-base-content/70 hover:text-primary focus-visible:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-base-100">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-base-300 pt-5 text-[13.5px] text-base-content/75 sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© 2026 Surf Skills</span>

      <div class="flex items-center gap-4">
        <a href={socialLinks[0].href} aria-label={socialLinks[0].label} class="rounded text-base-content/80 transition-colors hover:text-primary focus-visible:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-base-100">
          <!-- Email -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </a>
        <a href={socialLinks[1].href} target="_blank" rel="noopener noreferrer" aria-label={socialLinks[1].label} class="rounded text-base-content/80 transition-colors hover:text-primary focus-visible:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-base-100">
          <!-- LinkedIn -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a href={socialLinks[2].href} target="_blank" rel="noopener noreferrer" aria-label={socialLinks[2].label} class="rounded text-base-content/80 transition-colors hover:text-primary focus-visible:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-base-100">
          <!-- X / Twitter -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a href={socialLinks[3].href} target="_blank" rel="noopener noreferrer" aria-label={socialLinks[3].label} class="rounded text-base-content/80 transition-colors hover:text-primary focus-visible:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-base-100">
          <!-- GitHub -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
