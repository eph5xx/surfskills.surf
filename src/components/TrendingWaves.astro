---
import SkillCard from "./SkillCard.astro";
import { skills } from "@/data/skills";

// The full catalog: every skill as a card. Live ones link to their detail page,
// the rest show a "Coming soon" badge.
---

<!-- Sits on a solid surface band (full-bleed) so the sand reads as "outside". -->
<section
  id="skills"
  class="relative scroll-mt-24 py-16 before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:bg-base-100"
>
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {skills.map((s) => <SkillCard skill={s} />)}
  </div>
</section>
