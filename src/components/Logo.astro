---
interface Props {
  href?: string;
  class?: string;
}

const { href = "#top", class: className = "" } = Astro.props;
---

<a href={href} class:list={["inline-flex shrink-0 items-center", className]}>
  <img src="/logo.png" alt="Surf Skills" class="h-auto w-[135px] object-contain object-left md:w-[170px]" />
</a>
