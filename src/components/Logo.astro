---
interface Props {
  href?: string;
  class?: string;
}

const { href = "#top", class: className = "" } = Astro.props;
---

<a href={href} class:list={["inline-flex shrink-0 items-center", className]}>
  <img src="/logo.png" alt="surfskills.surf" class="h-10 w-[120px] object-contain object-left" />
</a>
