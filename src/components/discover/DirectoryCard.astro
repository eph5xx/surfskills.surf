---
import type { DirectoryItem } from "@/data/directory";
import { itemDataAttrs, compactNumber } from "@/data/directory";

// Catalog item — ONE [data-dir-item] node per skill (engine contract). The shared
// engine hides/sorts this single node; the toolbar's view toggle only flips
// [data-view] on the parent [data-dir-list], and the scoped rules below restyle the
// SAME node between grid (roomy 2-col card) and list (comfortable full-width row).
// Corners: name top-left, author top-right, collection/skill slug bottom-left,
// ★ stars bottom-right. `itemDataAttrs` emits every facet's data attribute, so a
// new registry field needs no change here.
interface Props {
  item: DirectoryItem;
}
const { item } = Astro.props;

// Marketplace slug e.g. "ponytail/ponytail-audit" (last two id segments).
const slug = item.id.split("/").slice(-2).join("/");
---

<a href={item.href} {...itemDataAttrs(item)} class="dc-item group">
  <figure class="dc-thumb">
    {
      item.video ? (
        <video
          class="size-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={item.image}
          data-vis-play
        >
          <source src={item.video} type="video/mp4" />
        </video>
      ) : (
        <img src={item.image ?? "/skills/skill-placeholder.svg"} alt="" loading="lazy" class="size-full object-cover" />
      )
    }
  </figure>

  <div class="dc-body">
    <div class="dc-top">
      <h3 class="dc-title font-display">{item.title}</h3>
      <span class="dc-author">
        {item.author.avatarURL && (
          <img src={item.author.avatarURL} alt="" loading="lazy" class="dc-avatar" />
        )}
        <span class="truncate">{item.author.name}</span>
      </span>
    </div>

    <p class="dc-blurb">{item.blurb}</p>

    <div class="dc-foot">
      <code class="dc-slug font-mono">{slug}</code>
      {
        item.githubStars !== undefined && (
          <span class="dc-stars">
            <svg viewBox="0 0 24 24" class="size-[13px] text-accent" fill="currentColor" aria-hidden="true">
              <path d="m12 2 2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z" />
            </svg>
            {compactNumber(item.githubStars)}
          </span>
        )
      }
    </div>
  </div>
</a>

<style>
  /* ---------- base (shared by both views) ---------- */
  .dc-item {
    display: flex;
    background: var(--color-base-100);
    color: var(--color-base-content);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-box);
    overflow: hidden;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.15s ease;
  }

  .dc-thumb {
    background: var(--color-base-200);
    overflow: hidden;
    flex-shrink: 0;
  }
  .dc-thumb :global(img),
  .dc-thumb :global(video) {
    transition: transform 0.4s ease;
  }
  .dc-item:hover .dc-thumb :global(img),
  .dc-item:hover .dc-thumb :global(video) {
    transform: scale(1.03);
  }

  .dc-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
  }

  /* top row: skill name (left) + author (right). The name is the scent the
     whole card exists for, so it wraps to two lines; the author caps at half
     the row and truncates instead of ever squeezing the title out. */
  .dc-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .dc-title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-base-content);
    min-width: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .dc-author {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    max-width: 50%;
    flex-shrink: 0;
    margin-top: 3px; /* optically align to the title's first line */
    font-size: 12.5px;
    color: color-mix(in oklab, var(--color-base-content) 55%, transparent);
  }
  .dc-avatar {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px var(--color-base-300);
  }
  @media (max-width: 479px) {
    /* Phone-width cards: the corner layout would hand half the row to the
       author, so the name takes the full row and the author drops below it. */
    .dc-top {
      flex-wrap: wrap;
      gap: 0.4rem 0.75rem;
    }
    .dc-title {
      flex-basis: 100%;
    }
    .dc-author {
      max-width: 100%;
      margin-top: 0;
    }
  }

  .dc-blurb {
    margin-top: 0.6rem;
    font-size: 14px;
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-base-content) 65%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* foot row: collection/skill slug (left) + ★ stars (right) */
  .dc-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.9rem;
  }
  .dc-slug {
    font-size: 11.5px;
    line-height: 1.2;
    color: color-mix(in oklab, var(--color-base-content) 50%, transparent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .dc-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    flex-shrink: 0;
    align-self: center;
    font-size: 12px;
    font-weight: 600;
    color: color-mix(in oklab, var(--color-base-content) 55%, transparent);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- GRID view (default): roomy 2-col card ---------- */
  :global([data-dir-list][data-view="grid"]) .dc-item {
    flex-direction: column;
  }
  :global([data-dir-list][data-view="grid"]) .dc-item:hover {
    box-shadow: 0 12px 30px -16px color-mix(in oklab, var(--color-base-content) 35%, transparent);
    border-color: color-mix(in oklab, var(--color-primary) 35%, var(--color-base-300));
    transform: translateY(-2px);
  }
  :global([data-dir-list][data-view="grid"]) .dc-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  :global([data-dir-list][data-view="grid"]) .dc-body {
    padding: 1.15rem 1.25rem 1.1rem;
  }

  /* ---------- LIST view (toggle): comfortable full-width row ---------- */
  :global([data-dir-list][data-view="list"]) .dc-item {
    flex-direction: row;
    align-items: stretch;
  }
  :global([data-dir-list][data-view="list"]) .dc-item:hover {
    box-shadow: 0 12px 30px -16px color-mix(in oklab, var(--color-base-content) 35%, transparent);
    border-color: color-mix(in oklab, var(--color-primary) 35%, var(--color-base-300));
  }
  :global([data-dir-list][data-view="list"]) .dc-thumb {
    flex: 0 0 240px;
    aspect-ratio: auto;
    align-self: stretch;
  }
  :global([data-dir-list][data-view="list"]) .dc-body {
    padding: 1.25rem 1.5rem;
  }
  :global([data-dir-list][data-view="list"]) .dc-blurb {
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    /* On the narrowest screens a list row stacks back to a card to stay readable. */
    :global([data-dir-list][data-view="list"]) .dc-item {
      flex-direction: column;
    }
    :global([data-dir-list][data-view="list"]) .dc-thumb {
      flex-basis: auto;
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>
