---
import type { DirectoryItem } from "@/data/directory";
import { itemDataAttrs, compactNumber } from "@/data/directory";

// Shared medium-density catalog card. `itemDataAttrs` emits every facet's data
// attribute automatically, so a new registry field needs no change here.
interface Props {
  item: DirectoryItem;
}
const { item } = Astro.props;
---

<a
  href={item.href}
  {...itemDataAttrs(item)}
  class="card card-border bg-base-100 overflow-hidden transition hover:shadow-md"
>
  <figure class="aspect-video bg-base-200">
    {
      item.video ? (
        <video class="size-full object-cover" autoplay muted loop playsinline preload="metadata">
          <source src={item.video} type="video/mp4" />
        </video>
      ) : (
        <img src="/skills/skill-placeholder.svg" alt="" loading="lazy" class="size-full object-cover" />
      )
    }
  </figure>
  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-[18px] font-semibold leading-tight text-base-content">{item.title}</h3>
      {
        item.githubStars !== undefined && (
          <span class="flex shrink-0 items-center gap-1 text-[12px] font-semibold text-base-content/55">
            <svg viewBox="0 0 24 24" class="size-[13px] text-accent" fill="currentColor" aria-hidden="true">
              <path d="m12 2 2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z" />
            </svg>
            {compactNumber(item.githubStars)}
          </span>
        )
      }
    </div>
    <p class="mt-1.5 line-clamp-2 text-[13.5px] leading-[1.5] text-base-content/65">{item.blurb}</p>
    <div class="mt-auto flex items-center gap-2 pt-4 text-[12px] text-base-content/50">
      {
        item.author.avatarURL && (
          <img src={item.author.avatarURL} alt="" loading="lazy" class="size-[18px] rounded-full ring-1 ring-base-300" />
        )
      }
      <span class="truncate">{item.author.name}</span>
    </div>
  </div>
</a>
