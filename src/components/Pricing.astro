---
// Paid CTAs go through /api/checkout, which routes anonymous visitors
// through login first, then on to Polar checkout.
const tiers = [
  {
    name: "Free",
    price: "$0",
    cadence: "forever",
    note: "No card required",
    perks: [
      "A starter set of skills, unlocked",
      "Preview what each one makes before you run it",
      "No technical skills needed",
    ],
    cta: "Start free →",
    href: "/login",
    featured: false,
  },
  {
    name: "Monthly",
    price: "$9",
    cadence: "/month",
    note: "Cancel anytime",
    perks: [
      "Every skill in the library, unlocked",
      "New skills added regularly",
      "Preview the output before you run it — never a gamble",
      "Finished deliverables, not lucky prompts",
    ],
    cta: "Get all-access →",
    href: "/api/checkout?plan=monthly",
    featured: true,
  },
  {
    name: "Yearly",
    price: "$60",
    cadence: "/year",
    note: "That's $5 a month",
    perks: [
      "Everything in Monthly",
      "Best value — save $48 a year",
      "Lock the price as the library grows",
    ],
    cta: "Get a year →",
    href: "/api/checkout?plan=yearly",
    featured: false,
  },
];
---

<!-- Faint teal wash band — the page's second (and last) ground shift. -->
<section
  id="pricing"
  class="relative scroll-mt-24 py-[72px] before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:bg-secondary/10"
>
  <div class="mb-[34px] text-center">
    <h1 class="text-[34px]">One pass, every wave</h1>
    <p class="mt-1.5 text-[15px] text-base-content/70">Start free. Upgrade when you're hooked.</p>
  </div>

  <!-- The page's one intentional equal-column grid: towers want columns. -->
  <div class="grid grid-cols-1 gap-[26px] md:grid-cols-3">
    {
      tiers.map((tier) => (
        <div
          class:list={[
            "card bg-base-100",
            tier.featured ? "border-2 border-primary shadow-md md:-translate-y-2" : "card-border",
          ]}
        >
          <div class="card-body p-8">
            <div class="min-h-[148px]">
              {tier.featured && <span class="badge badge-accent mb-3 font-bold">Most popular</span>}
              <h3 class="text-[24px]">{tier.name}</h3>
              <div class="mt-3 flex items-end gap-1.5">
                <span class="font-display text-[52px] leading-none">{tier.price}</span>
                <span class="mb-1.5 text-[15px] text-base-content/70">{tier.cadence}</span>
              </div>
              <span class="mt-1 block text-[13px] text-base-content/70">{tier.note}</span>
            </div>

            <ul class="mt-5 flex flex-1 flex-col gap-2.5">
              {tier.perks.map((perk) => (
                <li class="flex items-start gap-2.5 text-[14.5px]">
                  <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 text-accent" fill="none">
                    <path d="M5 12l4 4 10-10" stroke="currentColor" stroke-width="3.5" />
                  </svg>
                  {perk}
                </li>
              ))}
            </ul>

            <a
              href={tier.href}
              class:list={["btn btn-lg btn-block mt-7", tier.featured && "btn-primary"]}
            >
              {tier.cta}
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <p class="mt-6 text-center text-[13.5px] text-base-content/70">
    Instant access after checkout. Cancel anytime from your account — no emails, no hoops.
  </p>
</section>
