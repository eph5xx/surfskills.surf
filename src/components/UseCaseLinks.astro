---
import { USE_CASES, USE_CASE_LABELS, USE_CASE_SLUGS } from "@/data/skill-model";

// Internal-linking strip to the /discover/<use-case> landing pages. Used on the
// homepage and the Discover directory so crawlers (and people) reach every
// use-case page from high-traffic pages. The link set is driven by USE_CASES, so
// adding a use case surfaces it here automatically.
interface Props {
  heading?: string;
  class?: string;
}
const { heading = "Browse by use case", class: className } = Astro.props;
---

<nav aria-label="Skill use cases" class:list={[className]}>
  {heading && <h2 class="font-display text-[15px] font-semibold text-base-content/70">{heading}</h2>}
  <ul class="mt-3 flex flex-wrap gap-2">
    {
      USE_CASES.map((u) => (
        <li>
          <a
            href={`/discover/${USE_CASE_SLUGS[u]}`}
            class="inline-flex rounded-full border border-base-300 bg-base-100 px-3.5 py-1.5 text-[14px] font-medium text-base-content/80 transition-colors hover:border-primary hover:text-primary"
          >
            {USE_CASE_LABELS[u]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
