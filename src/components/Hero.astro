---
const { lastUpdated = "" } = Astro.props;
---

<section class="relative pb-16 pt-16 text-center">
  {lastUpdated && (
    <span
      class="badge badge-accent badge-lg mb-[22px] inline-flex h-auto items-center py-1.5 text-sm font-semibold sm:text-base"
    >
      <span class="whitespace-nowrap">Last updated {lastUpdated}</span>
    </span>
  )}

  <h1
    class="mx-auto mb-[18px] max-w-[900px] text-[clamp(52px,8.5vw,92px)] leading-[0.98] tracking-[-0.02em]"
  >
    Finally, AI skills<br />to get your work done
  </h1>

  <p class="mx-auto mb-[30px] max-w-[700px] text-balance text-[16px] leading-[1.6] text-base-content/70">
    Curated AI skills library for marketing, design, research, and more. Preview
    what each skill makes before you run it, so the output is never a gamble — no
    technical skills needed.
  </p>

  <div class="flex flex-wrap items-center justify-center gap-4">
    <a href="/login" class="btn btn-primary btn-lg">Join for free →</a>
    <a href="/discover" class="btn btn-lg">Discover skills</a>
  </div>
</section>
