---
const { lastUpdated = "" } = Astro.props;
---

<section id="content" class="relative pb-16 pt-16 text-center">
  {lastUpdated && (
    <span
      class="badge badge-accent badge-lg mb-[22px] inline-flex h-auto items-center py-1.5 text-sm font-semibold sm:text-base"
    >
      <span class="whitespace-nowrap">Last updated {lastUpdated}</span>
    </span>
  )}

  {/* The forced break holds only from sm up: below it the 2 halves rewrap into
      4 ragged lines, so phones get a balanced natural wrap at a smaller floor. */}
  <h1
    class="mx-auto mb-[18px] max-w-[900px] text-balance text-[clamp(40px,8.5vw,92px)] leading-[0.98] tracking-[-0.02em]"
  >
    Finally, AI skills<br class="hidden sm:inline" /> to get your work done
  </h1>

  {/* /85 ink, not /70: this sits over live video, where the scrim can't
      guarantee more than a sand-toned midground behind the text. */}
  <p class="mx-auto mb-[30px] max-w-[560px] text-balance text-[16px] leading-[1.6] text-base-content/85">
    Curated AI skills library for marketing, design, research, and more. Preview
    what each skill makes before you run it, so the output is never a gamble — no
    technical skills needed.
  </p>

  <div class="flex flex-wrap items-center justify-center gap-4">
    <a href="/login" class="btn btn-primary btn-lg">Join for free →</a>
    <a href="/discover" class="btn btn-lg">Discover skills</a>
  </div>

  <p class="mt-4 text-[13.5px] font-medium text-base-content/85">
    The free plan needs no card · <a href="/pricing" class="link link-hover underline-offset-2 hover:text-primary">see plans</a>
  </p>
</section>
