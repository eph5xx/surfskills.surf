---
// Hero — the promise in 5 seconds. Two columns: outcome-led copy on the left,
// a portrait "preview" panel on the right that reads as a vertical carousel of
// real skill demos with one card opened (so "preview before you install" is
// shown, not claimed). Sunny performs the hand-off next to it.
//
// Build-order note: the preview panel and Sunny are PLACEHOLDERS for now — the
// rendered vertical-carousel MP4 and the mascot cutout swap into these same
// slots later (see the hero-redesign plan). The framing, copy, and motion ship
// now. The panel is portrait 3:4 to match the video, so the swap causes no
// layout shift.
---

<section class="relative overflow-visible pb-8 pt-8 md:pt-14">
  <div
    class="relative grid grid-cols-1 items-center gap-10 md:grid-cols-[0.8fr_1.2fr] lg:gap-14"
  >
    <!-- ============ LEFT — the copy ============ -->
    <div class="min-w-0 text-center md:text-left">
      <h1
        class="hero-rise mx-auto max-w-[15ch] text-balance text-[clamp(40px,6vw,76px)] leading-[1.02] tracking-[-0.02em] md:mx-0"
        style="animation-delay:80ms"
      >
        Upgrade your generic AI to expert.
      </h1>

      <p
        class="hero-rise mx-auto mt-5 max-w-[46ch] text-pretty text-[16px] leading-[1.6] text-base-content/80 md:mx-0"
        style="animation-delay:160ms"
      >
        A curated library of agent skills. Preview what each one makes before you
        install it, so you're never guessing.
      </p>

      <div
        class="hero-rise mt-8 flex flex-wrap items-center justify-center gap-3 md:justify-start"
        style="animation-delay:240ms"
      >
        <a href="/discover" class="btn btn-primary btn-lg">Browse skills →</a>
        <a href="/login" class="btn btn-outline btn-lg">Join free</a>
      </div>
    </div>

    <!-- ============ RIGHT — the preview carousel + Sunny ============ -->
    <!-- Large frameless panel: the carousel plays as a transparent (alpha) video,
         so it floats directly on the sand — no white card behind it. Fills the
         column and bleeds toward the container edge on md+ for scale. -->
    <div
      class="hero-rise relative mx-auto min-w-0 md:-mr-8"
      style="animation-delay:140ms"
    >
      <!-- Portrait 3:4 stage for the transparent vertical-carousel video. No card
           chrome (no border/bg/shadow) so the alpha video sits on the sand;
           object-contain keeps the composited scene un-cropped. Reduced-motion and
           browsers without alpha-webm (Safari) get the transparent poster still. -->
      <div
        class="relative mx-auto aspect-[3/4] max-h-[min(74vh,720px)] w-full"
      >
        <video
          class="h-full w-full object-contain motion-reduce:hidden"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/hero-carousel.png"
        >
          <source src="/hero-carousel.webm" type="video/webm" />
          <source src="/hero-carousel.mp4" type='video/mp4; codecs="hvc1"' />
        </video>
        <img
          src="/hero-carousel.png"
          alt="A carousel of skill previews, each showing a skill's before and after result."
          class="hidden h-full w-full object-contain motion-reduce:block"
        />
      </div>

    </div>
  </div>
</section>

<style>
  /* One orchestrated page-load: elements rise + fade, staggered via inline
     animation-delay. CSS-driven (not gated on a JS class), so content renders
     with JS disabled and in headless/SSR captures. */
  .hero-rise {
    animation: hero-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-rise {
      animation: none;
    }
  }
</style>
