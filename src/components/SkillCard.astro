---
import { categories, type Skill } from "@/data/skills";
import { skillDetails } from "@/data/skill-details";

// One catalog card, reused on the landing grid and the Discover catalog.
// Live + has a detail page → full-color clickable card. Otherwise → greyed
// "Coming soon" tease (markup lifted from the old SkillShowcase tiles).
interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const emojiFor = (cat: string) => categories.find((c) => c.name === cat)?.emoji ?? "✨";
const live = skill.available && skill.slug in skillDetails;
---

{
  live ? (
    <a
      href={`/skills/${skill.slug}/`}
      class="card card-border border-base-300 bg-base-100 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="card-body justify-between gap-4 p-6">
        <div class="flex items-start justify-between gap-3">
          <span class="text-[22px]" aria-hidden="true">{emojiFor(skill.category)}</span>
          <span class="badge badge-ghost badge-sm text-base-content/55">{skill.category}</span>
        </div>
        <div>
          <h3 class="font-display text-[19px] leading-snug">{skill.title}</h3>
          <p class="mt-1 text-[13.5px] leading-[1.4] text-base-content/60">{skill.blurb}</p>
          <p class="mt-3 text-[12.5px] font-semibold text-secondary">{skill.thumbLabel} →</p>
        </div>
      </div>
    </a>
  ) : (
    <article class="card card-border border-base-300 bg-base-100/60 shadow-sm grayscale opacity-70 pointer-events-none">
      <div class="card-body justify-between gap-4 p-6">
        <div class="flex items-start justify-between gap-3">
          <span class="text-[22px]" aria-hidden="true">{emojiFor(skill.category)}</span>
          <span class="badge badge-ghost badge-sm gap-1.5 text-base-content/55">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-base-content/40" aria-hidden="true">
              <rect x="5" y="11" width="14" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
            Coming soon
          </span>
        </div>
        <div>
          <h3 class="font-display text-[19px] leading-snug text-base-content/75">{skill.title}</h3>
          <p class="mt-1 text-[13.5px] leading-[1.4] text-base-content/50">{skill.blurb}</p>
        </div>
      </div>
    </article>
  )
}
