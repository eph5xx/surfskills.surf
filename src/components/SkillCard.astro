---
import type { Skill } from "@/data/skills";

// One catalog card, reused on the landing grid and the Discover catalog.
// Live + has a detail page → full-color clickable card. Otherwise → greyed
// "Coming soon" tease (markup lifted from the old SkillShowcase tiles).
interface Props {
  skill: Skill;
  /** Collection roster tiles show video + name only — author/category inherited above. */
  hideCategory?: boolean;
}

const { skill, hideCategory = false } = Astro.props;
// `available` is the single source of truth for "has a live page": producers set
// it (static landing = true; DB catalog = row exists; coming-soon roster = false),
// so DB-only skills aren't wrongly greyed by a stale static index.
const live = skill.available;

// Roster tiles (hideCategory) run 2-up on phones and 5-up on desktop — the
// full 22px card title drowns those small tiles, so they step down.
const titleClass = hideCategory
  ? "font-display text-[17px] font-semibold leading-snug text-base-content sm:text-[19px]"
  : "font-display text-[22px] font-semibold leading-snug text-base-content";
---

{
  live ? (
    <a
      href={`/s/${skill.id}`}
      class="group block transition hover:-translate-y-0.5"
    >
      <div class="flex flex-col gap-3">
        <div class="aspect-video w-full overflow-hidden rounded-xl bg-base-200">
          {
            skill.video ? (
              <video
                class="size-full object-cover"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={skill.image}
                data-vis-play
              >
                <source src={skill.video} type="video/mp4" />
              </video>
            ) : skill.image ? (
              <img src={skill.image} alt="" loading="lazy" class="size-full object-cover" />
            ) : (
              <div class="relative size-full">
                <img src="/skills/skill-placeholder.svg" alt="" loading="lazy" class="size-full object-cover" />
                <span class="absolute inset-x-0 bottom-2 text-center text-[12px] font-medium text-base-content/55">
                  Demo coming soon
                </span>
              </div>
            )
          }
        </div>
        <div class="flex items-center justify-between gap-3">
          <h3 class={titleClass}>{skill.title}</h3>
          {!hideCategory && <span class="badge badge-ghost badge-sm text-base-content/60">{skill.category}</span>}
        </div>
      </div>
    </a>
  ) : (
    <article class="block opacity-80 pointer-events-none">
      <div class="flex flex-col gap-3">
        <div class="aspect-video w-full overflow-hidden rounded-xl bg-base-200">
          {
            skill.video ? (
              <video
                class="size-full object-cover"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={skill.image}
                data-vis-play
              >
                <source src={skill.video} type="video/mp4" />
              </video>
            ) : skill.image ? (
              <img src={skill.image} alt="" loading="lazy" class="size-full object-cover" />
            ) : (
              <div class="relative size-full">
                <img src="/skills/skill-placeholder.svg" alt="" loading="lazy" class="size-full object-cover" />
                <span class="absolute inset-x-0 bottom-2 text-center text-[12px] font-medium text-base-content/55">
                  Demo coming soon
                </span>
              </div>
            )
          }
        </div>
        <div class="flex items-center justify-between gap-3">
          <h3 class={titleClass}>{skill.title}</h3>
          {!hideCategory && <span class="badge badge-ghost badge-sm text-base-content/60">{skill.category}</span>}
        </div>
      </div>
    </article>
  )
}
