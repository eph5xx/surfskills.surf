---
import { skills, categories, type Skill } from "@/data/skills";

// "Catch another wave" — related skills as grayed-out coming-soon teases,
// matching the landing page's coming-soon tiles (SkillShowcase). Unknown slugs
// are skipped silently.
interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;

const related = slugs
  .map((slug) => skills.find((s) => s.slug === slug))
  .filter((s): s is Skill => s !== undefined);

const emojiFor = (cat: string) => categories.find((c) => c.name === cat)?.emoji ?? "✨";
---

<section class="mt-[72px]">
  <h2 class="mb-[26px] text-[34px]">Catch another wave</h2>
  <div class="grid grid-cols-1 gap-[26px] md:grid-cols-2 lg:grid-cols-3">
    {
      related.map((skill) => (
        <article class="card card-border border-base-300 bg-base-100/60 shadow-sm grayscale opacity-70 pointer-events-none">
          <div class="card-body justify-between gap-4 p-6">
            <div class="flex items-start justify-between gap-3">
              <span class="text-[22px]" aria-hidden="true">
                {emojiFor(skill.category)}
              </span>
              <span class="badge badge-ghost badge-sm gap-1.5 text-base-content/55">
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-base-content/40"
                  aria-hidden="true"
                >
                  <rect x="5" y="11" width="14" height="10" rx="2" />
                  <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                Coming soon
              </span>
            </div>
            <div>
              <h3 class="font-display text-[19px] leading-snug text-base-content/75">
                {skill.title}
              </h3>
              <p class="mt-1 text-[13.5px] leading-[1.4] text-base-content/50">{skill.blurb}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
