---
import { type Skill } from "@/data/skills";
import type { SkillContent } from "@/data/skill-details/types";
import SkillSidebar from "@/components/skill/SkillSidebar.astro";

// Reusable, data-driven skill listing template. Left column: identity -> demo ->
// how-it-works. Right column: a sticky rail with Collection, Links, and Install.
// To add a skill: add a catalog entry + a SkillContent module — no edits here.
interface Props {
  skill: Skill;
  content: SkillContent;
}

const { skill, content } = Astro.props;
const f = content.flow;

// Header icon-tile glyphs (white SVG path on a sienna tile). Add as needed.
const GLYPHS: Record<string, string> = {
  bars: '<rect x="3" y="13" width="4.4" height="8" rx="1.4"/><rect x="9.8" y="8" width="4.4" height="13" rx="1.4"/><rect x="16.6" y="3.5" width="4.4" height="17.5" rx="1.4"/>',
};
const glyph = GLYPHS[content.glyph ?? "bars"] ?? GLYPHS.bars;

// Command coloring: leading /command token in primary, the rest in accent.
const sp = content.command.indexOf(" ");
const cmdHead = sp === -1 ? content.command : content.command.slice(0, sp);
const cmdRest = sp === -1 ? "" : content.command.slice(sp);
---

<div class="bg-base-200">
  <div class="mx-auto max-w-[1180px] px-5 pt-10 pb-20 md:px-[60px] md:pt-[42px]">
    <nav class="breadcrumbs mb-7 text-[13.5px] font-semibold">
      <ul>
        <li><a href="/discover" class="text-secondary hover:text-primary">All skills</a></li>
        <li>
          <a href={`/collections/${content.collection.id}`} class="text-secondary hover:text-primary"
            >{content.collection.name}</a
          >
        </li>
        <li>{skill.title}</li>
      </ul>
    </nav>

    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_344px]">
      <!-- Identity -->
      <div class="order-1 lg:col-start-1">
        <div class="flex items-center gap-[18px]">
          <span
            class="grid size-[60px] shrink-0 place-items-center rounded-[17px] bg-primary shadow-[0_10px_22px_-10px_var(--color-primary)]"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" class="size-[30px]" fill="#fff" set:html={glyph} />
          </span>
          <div>
            <div class="font-mono text-[13px] font-semibold text-secondary">{content.commandLabel}</div>
            <h1
              class="mt-0.5 font-display text-[30px] font-semibold leading-[1.0] tracking-[-0.03em] text-balance md:text-[40px]"
            >
              {skill.title}
            </h1>
          </div>
        </div>

        <!-- Tagline -->
        <p class="mt-4 max-w-[54ch] text-[15px] leading-[1.55] text-base-content/65 text-pretty md:text-[16px]">
          {content.tagline}
        </p>
      </div>

      <!-- Demo video -->
      <div class="order-2 lg:col-start-1">
        <div
          class="aspect-[16/9.1] w-full overflow-hidden rounded-[18px] bg-[#1c1a28] shadow-[0_30px_70px_-28px_rgba(42,44,65,0.55)]"
        >
          {
            skill.video ? (
              <video
                class="size-full object-cover"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              >
                <source src={skill.video} type="video/mp4" />
              </video>
            ) : (
              /* ponytail: no images — text placeholder hero. Add a <video> if you want a demo. */
              <div class="grid size-full place-items-center bg-[#1c1a28] p-6 text-center text-[13px] font-medium text-base-100/55">
                {content.tagline}
              </div>
            )
          }
        </div>
      </div>

      <!-- Sidebar (mobile — sits between demo and How it works) -->
      <div class="order-3 flex flex-col gap-[18px] lg:hidden">
        <SkillSidebar skill={skill} content={content} />
      </div>

      <!-- How it works -->
      <div class="order-4 lg:col-start-1">
        <h2 class="font-display text-[24px] tracking-[-0.02em]">How it works</h2>

        <!-- Step 01 — includes the command terminal -->
        <div class="grid grid-cols-[44px_1fr] gap-[18px] border-t border-base-content/13 py-[26px] md:grid-cols-[52px_1fr] md:gap-[22px]">
          <div class="font-display text-[32px] font-light leading-none tracking-[-0.03em] text-primary md:text-[36px]">01</div>
          <div>
            <div class="text-[13.5px] font-semibold text-primary">{f.write.label}</div>
            <h3 class="mt-0.5 text-[18px] leading-[1.2] md:text-[19px]">{f.write.head}</h3>
            <p class="mt-2 max-w-[52ch] text-[15px] leading-[1.55] text-base-content/70">{f.write.body}</p>

            <!-- Command terminal — full width, copy button lives in the title bar -->
            <div class="mt-4 overflow-hidden rounded-xl border border-white/[0.06] bg-[#232132]">
              <div class="flex items-center gap-1.5 border-b border-white/[0.06] px-4 py-3">
                <span class="size-2.5 rounded-full" style="background:#e06c5e"></span>
                <span class="size-2.5 rounded-full" style="background:#f2b134"></span>
                <span class="size-2.5 rounded-full" style="background:#5bbd7a"></span>
                <button
                  type="button"
                  data-copy-cmd
                  data-copy={content.command}
                  aria-label="Copy command"
                  class="swap swap-rotate ml-auto text-white/50 transition-colors hover:text-white"
                >
                  <svg class="swap-off size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11" rx="2" />
                    <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                  </svg>
                  <svg class="swap-on size-[15px] text-[#5bbd7a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                </button>
              </div>
              <code class="block px-5 py-4 font-mono text-[14px] leading-[1.6] break-words whitespace-pre-wrap text-[#e9e6f2]">
                <span class="text-primary">{cmdHead}</span><span class="text-accent">{cmdRest}</span>
              </code>
            </div>
          </div>
        </div>

        <!-- Step 02 -->
        <div class="grid grid-cols-[44px_1fr] gap-[18px] border-t border-base-content/13 py-[26px] md:grid-cols-[52px_1fr] md:gap-[22px]">
          <div class="font-display text-[32px] font-light leading-none tracking-[-0.03em] text-primary md:text-[36px]">02</div>
          <div>
            <div class="text-[13.5px] font-semibold text-primary">{f.between.label}</div>
            <h3 class="mt-0.5 text-[18px] leading-[1.2] md:text-[19px]">{f.between.head}</h3>
            <p class="mt-2 max-w-[52ch] text-[15px] leading-[1.55] text-base-content/70">{f.between.body}</p>
          </div>
        </div>

        <!-- Step 03 -->
        <div class="grid grid-cols-[44px_1fr] gap-[18px] border-t border-base-content/13 py-[26px] md:grid-cols-[52px_1fr] md:gap-[22px]">
          <div class="font-display text-[32px] font-light leading-none tracking-[-0.03em] text-primary md:text-[36px]">03</div>
          <div>
            <div class="text-[13.5px] font-semibold text-primary">{f.get.label}</div>
            <h3 class="mt-0.5 text-[18px] leading-[1.2] md:text-[19px]">{f.get.head}</h3>
            <p class="mt-2 max-w-[52ch] text-[15px] leading-[1.55] text-base-content/70">{f.get.body}</p>
          </div>
        </div>
      </div>

      <!-- Sidebar (desktop) — Collection + Links + Install as one sticky column -->
      <aside class="order-3 hidden flex-col gap-[18px] lg:sticky lg:top-[92px] lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:flex lg:self-start">
        <SkillSidebar skill={skill} content={content} />
      </aside>
    </div>
  </div>
</div>

<script>
  // Copy the run command. Bound via [data-copy-cmd] (the icon button in the
  // terminal title bar); the DaisyUI swap flips copy→check for 1.5s.
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy-cmd]")) {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy");
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      btn.classList.add("swap-active");
      window.clearTimeout(Number(btn.dataset.copyTimer));
      btn.dataset.copyTimer = String(
        window.setTimeout(() => btn.classList.remove("swap-active"), 1500),
      );
    });
  }

  // "Paste into your agent" — copies the full install command, then flips the
  // label to a confirmation for 1.5s (no navigation).
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-paste-cta]")) {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy");
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      const label = btn.querySelector<HTMLElement>("[data-paste-label]");
      if (!label) return;
      if (!btn.dataset.pasteLabel) btn.dataset.pasteLabel = label.textContent ?? "";
      label.textContent = "Copied to clipboard";
      window.clearTimeout(Number(btn.dataset.pasteTimer));
      btn.dataset.pasteTimer = String(
        window.setTimeout(() => {
          label.textContent = btn.dataset.pasteLabel ?? "";
        }, 1500),
      );
    });
  }

  for (const el of document.querySelectorAll<HTMLElement>(".ph-install-cta")) {
    el.addEventListener("click", () => {
      window.posthog?.capture("skill_repo_clicked", {
        skill_slug: el.dataset.skillSlug,
        free: el.dataset.skillFree === "1",
        category: el.dataset.skillCategory,
      });
    });
  }
</script>
