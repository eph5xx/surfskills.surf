---
import type { Collection, DirectorySkill } from "@/data/skill-model/types";
import { skillSlugFromId } from "@/data/skill-model";
import type { Skill } from "@/data/skills";
import SkillCard from "@/components/SkillCard.astro";
import SkillSidebar from "@/components/skill/SkillSidebar.astro";

// Reusable, data-driven skill listing template. Left column: identity -> demo ->
// how-it-works -> details. Right column: a sticky rail with Collection, Links, and
// Install. To add a skill: add a DirectorySkill + Collection module — no edits here.
interface Props {
  skill: DirectorySkill;
  collection: Collection;
  relatedSkills?: Skill[];
}

const { skill, collection, relatedSkills = [] } = Astro.props;

const slug = skillSlugFromId(skill.id);

// The three "How it works" beats — input / process / output from the skill model.
// The friendly label is the step heading; the jargon (Input/Process/Output) is dropped.
const flow = {
  write: { label: "You write", body: skill.description.input },
  between: { label: "It works", body: skill.description.process },
  get: { label: "You get", body: skill.description.output },
};

// Command coloring: a leading "/command" token renders in primary, its argument in
// accent. Prose examples (no leading slash) aren't commands — they render whole in
// accent, with no command-head highlight.
const isCommand = skill.example.startsWith("/");
const sp = skill.example.indexOf(" ");
const cmdHead = sp === -1 ? skill.example : skill.example.slice(0, sp);
const cmdRest = sp === -1 ? "" : skill.example.slice(sp);

---

<div class="bg-base-200">
  <main id="content" class="mx-auto max-w-[1200px] px-5 pt-10 pb-20 md:px-8 md:pt-[42px]">
    <nav class="breadcrumbs mb-7 text-[13.5px] font-semibold">
      <ul>
        <li><a href="/discover" class="text-secondary hover:text-primary">All skills</a></li>
        <li>
          <a href={`/s/${collection.id}`} class="text-secondary hover:text-primary"
            >{collection.name}</a
          >
        </li>
        <li>{skill.name}</li>
      </ul>
    </nav>

    <div class="grid grid-cols-1 items-start gap-[44px] lg:grid-cols-[1fr_336px]">
      <!-- Identity -->
      <div class="order-1 lg:col-start-1">
        <div class="font-mono text-[13px] font-semibold text-secondary">{slug}</div>
        <h1
          class="mt-0.5 font-display text-[30px] font-semibold leading-[1.0] tracking-[-0.03em] text-balance md:text-[40px]"
        >
          {skill.name}
        </h1>

        <!-- Tagline -->
        <p class="mt-4 max-w-[60ch] text-[15px] leading-[1.55] text-base-content/65 text-pretty md:text-[16px]">
          {skill.description.short}
        </p>
      </div>

      <!-- Demo video -->
      <div class="order-2 lg:col-start-1">
        <div
          class="aspect-[16/9.1] w-full overflow-hidden rounded-[18px] bg-plum shadow-[0_30px_70px_-28px_rgba(42,44,65,0.55)]"
        >
          {
            skill.previewVideo ? (
              <video
                class="size-full object-cover"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={skill.previewImage}
                data-vis-play
              >
                <source src={skill.previewVideo} type="video/mp4" />
              </video>
            ) : skill.previewImage ? (
              <img src={skill.previewImage} alt="" class="size-full object-cover" loading="lazy" />
            ) : (
              /* No video or still — text placeholder hero. */
              <div class="grid size-full place-items-center bg-plum p-6 text-center text-[13px] font-medium text-base-100/55">
                {skill.description.short}
              </div>
            )
          }
        </div>
      </div>

      <!-- Sidebar (mobile — sits between demo and How it works) -->
      <div class="order-3 flex flex-col gap-[18px] lg:hidden">
        <SkillSidebar skill={skill} collection={collection} />
      </div>

      <!-- How it works -->
      <div class="order-4 lg:col-start-1">
        <h2 class="font-display text-[24px] tracking-[-0.02em]">How it works</h2>

        <!-- Step 01 — includes the command terminal -->
        <div class="grid grid-cols-[44px_1fr] gap-[18px] border-t border-base-content/13 py-[26px] md:grid-cols-[52px_1fr] md:gap-[22px]">
          <div class="font-display text-[32px] font-light leading-none tracking-[-0.03em] text-primary md:text-[36px]">01</div>
          <div>
            <h3 class="font-display text-[18px] leading-[1.2] md:text-[19px]">{flow.write.label}</h3>
            <p class="mt-2 max-w-[60ch] text-[15px] leading-[1.55] text-base-content/70">{flow.write.body}</p>

            <!-- What-you-type panel — sand, matching the WhatIsIt folder panel and the
                 sidebar install row. The plum video above stays the only dark surface. -->
            <div class="mt-4 rounded-field border border-base-300 bg-base-200/60">
              <div class="flex items-center justify-between gap-3 border-b border-base-300 px-4 py-2.5">
                <span class="text-[13.5px] font-semibold text-base-content/70">What you type</span>
                <button
                  type="button"
                  data-copy-cmd
                  data-copy={skill.example}
                  aria-label="Copy command"
                  class="swap swap-rotate text-base-content/55 transition-colors hover:text-primary"
                >
                  <svg class="swap-off size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11" rx="2" />
                    <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                  </svg>
                  <svg class="swap-on size-[15px] text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                </button>
              </div>
              <code class="block px-4 py-3.5 font-mono text-[13.5px] leading-[1.6] break-words whitespace-pre-wrap text-base-content/85">
                {isCommand ? (
                  <Fragment><span class="font-semibold text-secondary">{cmdHead}</span>{cmdRest}</Fragment>
                ) : (
                  skill.example
                )}
              </code>
            </div>
          </div>
        </div>

        <!-- Step 02 -->
        <div class="grid grid-cols-[44px_1fr] gap-[18px] border-t border-base-content/13 py-[26px] md:grid-cols-[52px_1fr] md:gap-[22px]">
          <div class="font-display text-[32px] font-light leading-none tracking-[-0.03em] text-primary md:text-[36px]">02</div>
          <div>
            <h3 class="font-display text-[18px] leading-[1.2] md:text-[19px]">{flow.between.label}</h3>
            <p class="mt-2 max-w-[60ch] text-[15px] leading-[1.55] text-base-content/70">{flow.between.body}</p>
          </div>
        </div>

        <!-- Step 03 -->
        <div class="grid grid-cols-[44px_1fr] gap-[18px] border-t border-base-content/13 py-[26px] md:grid-cols-[52px_1fr] md:gap-[22px]">
          <div class="font-display text-[32px] font-light leading-none tracking-[-0.03em] text-primary md:text-[36px]">03</div>
          <div>
            <h3 class="font-display text-[18px] leading-[1.2] md:text-[19px]">{flow.get.label}</h3>
            <p class="mt-2 max-w-[60ch] text-[15px] leading-[1.55] text-base-content/70">{flow.get.body}</p>
          </div>
        </div>
      </div>

      {
        relatedSkills.length > 0 && (
          <div class="order-5 lg:col-start-1">
            <h2 class="font-display text-[24px] tracking-[-0.02em]">Related skills</h2>
            <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
              {relatedSkills.map((related) => <SkillCard skill={related} />)}
            </div>
          </div>
        )
      }

      <!-- Sidebar (desktop) — Collection + Links + Install as one sticky column -->
      <aside class="order-3 hidden flex-col gap-[18px] lg:sticky lg:top-[92px] lg:col-start-2 lg:row-span-4 lg:row-start-1 lg:flex lg:self-start">
        <SkillSidebar skill={skill} collection={collection} />
      </aside>
    </div>
  </main>
</div>

<script>
  // Copy buttons ([data-copy-cmd] / [data-paste-cta]) with a global "Copied!"
  // toast, robust clipboard fallback, and the PostHog install-CTA capture.
  import "@/scripts/copy-feedback";
</script>
