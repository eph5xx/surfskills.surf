---
import { skills, categories, type Skill } from "@/data/skills";
import { skillDetails } from "@/data/skill-details";
import type { SkillContent } from "@/data/skill-details/types";

// Reusable, data-driven skill listing template (ported from the design handoff
// V3 layout). Left column: identity → demo → how-it-works. Right column: a
// sticky install rail with action, compatibility, author, and similar skills.
// To add a skill: add a catalog entry + a SkillContent module — no edits here.
interface Props {
  skill: Skill;
  content: SkillContent;
  /** One URL for every state — the endpoint routes login/checkout/file. */
  downloadHref: string;
}

const { skill, content, downloadHref } = Astro.props;
const f = content.flow;

// Header icon-tile glyphs (white SVG path on a sienna tile). Add as needed.
const GLYPHS: Record<string, string> = {
  bars: '<rect x="3" y="13" width="4.4" height="8" rx="1.4"/><rect x="9.8" y="8" width="4.4" height="13" rx="1.4"/><rect x="16.6" y="3.5" width="4.4" height="17.5" rx="1.4"/>',
};
const glyph = GLYPHS[content.glyph ?? "bars"] ?? GLYPHS.bars;

// Real brand logos from /public/logos (same assets as WhatIsIt.astro). Names
// without a logo fall back to a first-letter monogram below.
const TOOL_LOGOS: Record<string, string> = {
  "Claude Code": "/logos/claude-code.svg",
  Claude: "/logos/claude.svg",
  Codex: "/logos/openai.svg",
  ChatGPT: "/logos/openai.svg",
  Cursor: "/logos/cursor.svg",
  "Gemini CLI": "/logos/gemini.svg",
  Gemini: "/logos/gemini.svg",
  Lovable: "/logos/lovable.svg",
};

const initials = content.author.name
  .split(/\s+/)
  .map((w) => w[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();

// Command coloring: leading /command token in primary, the rest in accent.
const sp = content.command.indexOf(" ");
const cmdHead = sp === -1 ? content.command : content.command.slice(0, sp);
const cmdRest = sp === -1 ? "" : content.command.slice(sp);

const emojiFor = (cat: string) => categories.find((c) => c.name === cat)?.emoji ?? "✨";
const related = content.relatedSlugs
  .map((s) => skills.find((k) => k.slug === s))
  .filter((s): s is Skill => s !== undefined);
const hasPage = (s: Skill) => s.available && s.slug in skillDetails;
---

<div class="bg-base-200">
  <div class="mx-auto max-w-[1180px] px-5 pt-10 pb-20 md:px-[60px] md:pt-[42px]">
    <nav class="breadcrumbs mb-7 text-[13.5px] font-semibold">
      <ul>
        <li><a href="/discover" class="text-secondary hover:text-primary">All skills</a></li>
        <li>{skill.title}</li>
      </ul>
    </nav>

    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_344px]">
      <!-- Identity -->
      <div class="order-1 lg:col-start-1">
        <!-- Header -->
        <div class="flex items-center gap-[18px]">
          <span
            class="grid size-[60px] shrink-0 place-items-center rounded-[17px] bg-primary shadow-[0_10px_22px_-10px_var(--color-primary)]"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" class="size-[30px]" fill="#fff" set:html={glyph} />
          </span>
          <div>
            <p class="text-[13.5px] font-semibold text-base-content/55">
              <span class="font-bold text-base-content">{skill.category}</span>
            </p>
            <h1
              class="mt-0.5 font-display text-[30px] font-semibold leading-[1.0] tracking-[-0.03em] text-balance md:text-[40px]"
            >
              {skill.title}
            </h1>
          </div>
        </div>

        <!-- Tagline -->
        <p class="mt-4 max-w-[54ch] text-[15px] leading-[1.55] text-base-content/65 text-pretty md:text-[16px]">
          {content.tagline}
        </p>
      </div>

      <!-- Demo video -->
      <div class="order-2 lg:col-start-1">
        <div
          class="aspect-[16/9.1] w-full overflow-hidden rounded-[18px] bg-[#1c1a28] shadow-[0_30px_70px_-28px_rgba(42,44,65,0.55)]"
        >
          {
            skill.video ? (
              <video
                class="size-full object-cover"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={skill.image}
              >
                <source src={skill.video} type="video/mp4" />
              </video>
            ) : (
              <img src={skill.image} alt={skill.imageAlt} class="size-full object-cover" />
            )
          }
        </div>
      </div>

      <!-- Install card (mobile only — sits between demo and How it works) -->
      <div class="order-3 lg:hidden">
        <div class="card card-border border-base-content/13 rounded-[22px] bg-base-100 p-6 shadow-[0_24px_50px_-36px_rgba(42,44,65,0.5)]">
          <a
            href={downloadHref}
            class="btn btn-primary btn-lg btn-block gap-2 rounded-[14px] text-[18px] shadow-[0_10px_24px_-10px_var(--color-primary)]"
          >
            <svg viewBox="0 0 24 24" class="size-[19px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" />
            </svg>
            {skill.free ? "Install free skill" : "Install skill"}
          </a>
          <a
            href={content.github}
            target="_blank"
            rel="noopener"
            class="mt-3.5 flex items-center justify-center gap-2 text-[15px] font-semibold text-base-content/70 hover:text-primary"
          >
            <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.6 0 0 3.6 0 8c0 3.5 2.3 6.5 5.5 7.6.4.1.5-.2.5-.4v-1.4c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-3.9 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.5 1.1.2 1.9.1 2.1.5.5.8 1.2.8 2.1 0 3-1.8 3.7-3.6 3.9.3.3.6.8.6 1.6v2.4c0 .2.1.5.6.4A8 8 0 0016 8c0-4.4-3.6-8-8-8z" />
            </svg>
            View on GitHub
          </a>
        </div>
      </div>

      <!-- How it works -->
      <div class="order-4 lg:col-start-1">
        <h2 class="font-display text-[24px] tracking-[-0.02em]">How it works</h2>

        <!-- Step 01 — includes the command terminal -->
        <div class="grid grid-cols-[44px_1fr] gap-[18px] border-t border-base-content/13 py-[26px] md:grid-cols-[52px_1fr] md:gap-[22px]">
          <div class="font-display text-[32px] font-light leading-none tracking-[-0.03em] text-primary md:text-[36px]">01</div>
          <div>
            <div class="text-[13.5px] font-semibold text-primary">{f.write.label}</div>
            <h3 class="mt-0.5 text-[18px] leading-[1.2] md:text-[19px]">{f.write.head}</h3>
            <p class="mt-2 max-w-[52ch] text-[15px] leading-[1.55] text-base-content/70">{f.write.body}</p>

            <!-- Command terminal — full width, copy button lives in the title bar -->
            <div class="mt-4 overflow-hidden rounded-xl border border-white/[0.06] bg-[#232132]">
              <div class="flex items-center gap-1.5 border-b border-white/[0.06] px-4 py-3">
                <span class="size-2.5 rounded-full" style="background:#e06c5e"></span>
                <span class="size-2.5 rounded-full" style="background:#f2b134"></span>
                <span class="size-2.5 rounded-full" style="background:#5bbd7a"></span>
                <button
                  type="button"
                  data-copy-cmd
                  data-copy={content.command}
                  aria-label="Copy command"
                  class="swap swap-rotate ml-auto text-white/50 transition-colors hover:text-white"
                >
                  <svg class="swap-off size-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11" rx="2" />
                    <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                  </svg>
                  <svg class="swap-on size-[15px] text-[#5bbd7a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                </button>
              </div>
              <code class="block px-5 py-4 font-mono text-[14px] leading-[1.6] break-words whitespace-pre-wrap text-[#e9e6f2]">
                <span class="text-primary">{cmdHead}</span><span class="text-accent">{cmdRest}</span>
              </code>
            </div>
          </div>
        </div>

        <!-- Step 02 -->
        <div class="grid grid-cols-[44px_1fr] gap-[18px] border-t border-base-content/13 py-[26px] md:grid-cols-[52px_1fr] md:gap-[22px]">
          <div class="font-display text-[32px] font-light leading-none tracking-[-0.03em] text-primary md:text-[36px]">02</div>
          <div>
            <div class="text-[13.5px] font-semibold text-primary">{f.between.label}</div>
            <h3 class="mt-0.5 text-[18px] leading-[1.2] md:text-[19px]">{f.between.head}</h3>
            <p class="mt-2 max-w-[52ch] text-[15px] leading-[1.55] text-base-content/70">{f.between.body}</p>
          </div>
        </div>

        <!-- Step 03 -->
        <div class="grid grid-cols-[44px_1fr] gap-[18px] border-t border-base-content/13 py-[26px] md:grid-cols-[52px_1fr] md:gap-[22px]">
          <div class="font-display text-[32px] font-light leading-none tracking-[-0.03em] text-primary md:text-[36px]">03</div>
          <div>
            <div class="text-[13.5px] font-semibold text-primary">{f.get.label}</div>
            <h3 class="mt-0.5 text-[18px] leading-[1.2] md:text-[19px]">{f.get.head}</h3>
            <p class="mt-2 max-w-[52ch] text-[15px] leading-[1.55] text-base-content/70">{f.get.body}</p>
          </div>
        </div>
      </div>

      <!-- Info + similar skills (mobile only) -->
      <div class="order-5 flex flex-col gap-[18px] lg:hidden">
        <div class="card card-border border-base-content/13 rounded-[22px] bg-base-100 px-6 py-[22px] shadow-[0_24px_50px_-36px_rgba(42,44,65,0.5)]">
          <!-- Works with -->
          <div>
            <div class="text-[14px] font-semibold text-base-content/55">Works with</div>
            <div class="mt-3 flex flex-col gap-[11px]">
              {
                content.worksWith.map((t) => {
                  const logo = TOOL_LOGOS[t];
                  return (
                    <span class="flex items-center gap-2.5 text-[15px] font-medium">
                      <span class="grid size-6 shrink-0 place-items-center rounded-md border border-base-300 bg-base-100">
                        {logo ? (
                          <img src={logo} alt="" loading="lazy" class="h-3.5 w-auto" />
                        ) : (
                          <span class="font-mono text-[11px] font-bold text-base-content/70" aria-hidden="true">
                            {t[0]}
                          </span>
                        )}
                      </span>
                      {t}
                    </span>
                  );
                })
              }
              {content.worksWithNote && (
                <span class="text-[13.5px] text-base-content/55">{content.worksWithNote}</span>
              )}
            </div>
          </div>

          <!-- Setup -->
          <div class="mt-[18px] border-t border-base-content/13 pt-[18px]">
            <div class="text-[14px] font-semibold text-base-content/55">Setup</div>
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-[7px]">
              {
                content.setup.map((n) => (
                  <span class="flex items-center gap-1.5 text-[13.5px] text-base-content/55">
                    <svg class="size-3 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6L9 17l-5-5" />
                    </svg>
                    {n}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Author -->
          <div class="mt-[18px] border-t border-base-content/13 pt-[18px]">
            <div class="text-[14px] font-semibold text-base-content/55">Author</div>
            <a
              href={content.author.githubUrl}
              target="_blank"
              rel="noopener"
              class="mt-3 flex items-center gap-[11px] hover:text-primary"
            >
              <span
                class="grid size-[34px] shrink-0 place-items-center rounded-full bg-secondary font-display text-[13px] text-secondary-content"
                aria-hidden="true">{initials}</span
              >
              <span class="leading-tight">
                <span class="block text-[12.5px] text-base-content/55">Built by</span>
                <span class="block text-[15px] font-semibold">{content.author.name}</span>
              </span>
            </a>
          </div>
        </div>

        <!-- Similar skills -->
        {
          related.length > 0 && (
            <div class="card card-border border-base-content/13 rounded-[22px] bg-base-100 px-6 py-[22px] shadow-[0_24px_50px_-36px_rgba(42,44,65,0.5)]">
              <div class="text-[14px] font-semibold text-base-content/55">Similar skills</div>
              <div class="mt-3 flex flex-col gap-2.5">
                {related.map((s) => {
                  const Tag = hasPage(s) ? "a" : "div";
                  return (
                    <Tag
                      href={hasPage(s) ? `/skills/${s.slug}` : undefined}
                      class:list={[
                        "block rounded-2xl border border-base-300 bg-base-100/60 p-3.5 transition-colors",
                        hasPage(s) ? "hover:border-primary/40 hover:bg-base-200" : "cursor-default",
                      ]}
                    >
                      <span class="flex items-center justify-between gap-2">
                        <span class="text-[18px]" aria-hidden="true">{emojiFor(s.category)}</span>
                        {!hasPage(s) && (
                          <span class="badge badge-ghost badge-sm text-base-content/55">Soon</span>
                        )}
                      </span>
                      <b class="mt-2 block font-display text-[15px] font-semibold leading-snug">{s.title}</b>
                      <span class="mt-1 block text-[12.5px] leading-[1.4] text-base-content/55 line-clamp-2">
                        {s.blurb}
                      </span>
                    </Tag>
                  );
                })}
              </div>
            </div>
          )
        }
      </div>

      <!-- Sidebar (desktop) — install + info + similar as one column -->
      <aside class="order-3 hidden flex-col gap-[18px] lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:flex">
        <div class="card card-border border-base-content/13 rounded-[22px] bg-base-100 p-6 shadow-[0_24px_50px_-36px_rgba(42,44,65,0.5)]">
          <a
            href={downloadHref}
            class="btn btn-primary btn-lg btn-block gap-2 rounded-[14px] text-[18px] shadow-[0_10px_24px_-10px_var(--color-primary)]"
          >
            <svg viewBox="0 0 24 24" class="size-[19px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" />
            </svg>
            {skill.free ? "Install free skill" : "Install skill"}
          </a>
          <a
            href={content.github}
            target="_blank"
            rel="noopener"
            class="mt-3.5 flex items-center justify-center gap-2 text-[15px] font-semibold text-base-content/70 hover:text-primary"
          >
            <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.6 0 0 3.6 0 8c0 3.5 2.3 6.5 5.5 7.6.4.1.5-.2.5-.4v-1.4c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.2 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-3.9 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.5 1.1.2 1.9.1 2.1.5.5.8 1.2.8 2.1 0 3-1.8 3.7-3.6 3.9.3.3.6.8.6 1.6v2.4c0 .2.1.5.6.4A8 8 0 0016 8c0-4.4-3.6-8-8-8z" />
            </svg>
            View on GitHub
          </a>
        </div>

        <div class="card card-border border-base-content/13 rounded-[22px] bg-base-100 px-6 py-[22px] shadow-[0_24px_50px_-36px_rgba(42,44,65,0.5)]">
          <!-- Works with -->
          <div>
            <div class="text-[14px] font-semibold text-base-content/55">Works with</div>
            <div class="mt-3 flex flex-col gap-[11px]">
              {
                content.worksWith.map((t) => {
                  const logo = TOOL_LOGOS[t];
                  return (
                    <span class="flex items-center gap-2.5 text-[15px] font-medium">
                      <span class="grid size-6 shrink-0 place-items-center rounded-md border border-base-300 bg-base-100">
                        {logo ? (
                          <img src={logo} alt="" loading="lazy" class="h-3.5 w-auto" />
                        ) : (
                          <span class="font-mono text-[11px] font-bold text-base-content/70" aria-hidden="true">
                            {t[0]}
                          </span>
                        )}
                      </span>
                      {t}
                    </span>
                  );
                })
              }
              {content.worksWithNote && (
                <span class="text-[13.5px] text-base-content/55">{content.worksWithNote}</span>
              )}
            </div>
          </div>

          <!-- Setup -->
          <div class="mt-[18px] border-t border-base-content/13 pt-[18px]">
            <div class="text-[14px] font-semibold text-base-content/55">Setup</div>
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-[7px]">
              {
                content.setup.map((n) => (
                  <span class="flex items-center gap-1.5 text-[13.5px] text-base-content/55">
                    <svg class="size-3 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6L9 17l-5-5" />
                    </svg>
                    {n}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Author -->
          <div class="mt-[18px] border-t border-base-content/13 pt-[18px]">
            <div class="text-[14px] font-semibold text-base-content/55">Author</div>
            <a
              href={content.author.githubUrl}
              target="_blank"
              rel="noopener"
              class="mt-3 flex items-center gap-[11px] hover:text-primary"
            >
              <span
                class="grid size-[34px] shrink-0 place-items-center rounded-full bg-secondary font-display text-[13px] text-secondary-content"
                aria-hidden="true">{initials}</span
              >
              <span class="leading-tight">
                <span class="block text-[12.5px] text-base-content/55">Built by</span>
                <span class="block text-[15px] font-semibold">{content.author.name}</span>
              </span>
            </a>
          </div>
        </div>

        {
          related.length > 0 && (
            <div class="card card-border border-base-content/13 rounded-[22px] bg-base-100 px-6 py-[22px] shadow-[0_24px_50px_-36px_rgba(42,44,65,0.5)]">
              <div class="text-[14px] font-semibold text-base-content/55">Similar skills</div>
              <div class="mt-3 flex flex-col gap-2.5">
                {related.map((s) => {
                  const Tag = hasPage(s) ? "a" : "div";
                  return (
                    <Tag
                      href={hasPage(s) ? `/skills/${s.slug}` : undefined}
                      class:list={[
                        "block rounded-2xl border border-base-300 bg-base-100/60 p-3.5 transition-colors",
                        hasPage(s) ? "hover:border-primary/40 hover:bg-base-200" : "cursor-default",
                      ]}
                    >
                      <span class="flex items-center justify-between gap-2">
                        <span class="text-[18px]" aria-hidden="true">{emojiFor(s.category)}</span>
                        {!hasPage(s) && (
                          <span class="badge badge-ghost badge-sm text-base-content/55">Soon</span>
                        )}
                      </span>
                      <b class="mt-2 block font-display text-[15px] font-semibold leading-snug">{s.title}</b>
                      <span class="mt-1 block text-[12.5px] leading-[1.4] text-base-content/55 line-clamp-2">
                        {s.blurb}
                      </span>
                    </Tag>
                  );
                })}
              </div>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</div>

<script>
  // Copy the run command. Bound via [data-copy-cmd] (the icon button in the
  // terminal title bar); the DaisyUI swap flips copy→check for 1.5s.
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy-cmd]")) {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy");
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      btn.classList.add("swap-active");
      window.clearTimeout(Number(btn.dataset.copyTimer));
      btn.dataset.copyTimer = String(
        window.setTimeout(() => btn.classList.remove("swap-active"), 1500),
      );
    });
  }
</script>
