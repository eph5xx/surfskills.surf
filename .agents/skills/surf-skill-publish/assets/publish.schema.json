{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "publish.json",
  "description": "Receipt written by scripts/publish.mjs once the card is in skills with its day.",
  "type": "object",
  "required": ["publish_on", "video_url", "cover_url", "collection_queued", "queued_at"],
  "additionalProperties": false,
  "properties": {
    "publish_on": {
      "description": "The card's skills.day: it goes live at midnight in Yerevan on this day.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "video_url": {
      "type": "string",
      "pattern": "^https://media\\.surfskills\\.surf/skills/.+\\.mp4$"
    },
    "cover_url": {
      "type": "string",
      "pattern": "^https://media\\.surfskills\\.surf/skills/.+\\.(webp|png|jpg)$"
    },
    "collection_queued": {
      "description": "Publish also inserted a new collection row.",
      "type": "boolean"
    },
    "queued_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
