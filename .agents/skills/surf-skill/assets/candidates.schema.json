{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pick candidate pool (cards/.pick/<date>-<source>.json)",
  "type": "object",
  "required": ["generated_at", "source", "repos", "dropped"],
  "additionalProperties": false,
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "enum": ["trending", "catalog"] },
    "repos": {
      "description": "Repos that are skill packs. Skills that already have a card folder are removed on every run.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "in_catalog", "stars", "commit", "files_dir", "hype", "skill_share", "flags", "skills"],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "description": { "type": ["string", "null"] },
          "in_catalog": { "type": ["boolean", "null"] },
          "stars": { "type": "integer" },
          "license": { "description": "SPDX id, or null when GitHub found none.", "type": ["string", "null"] },
          "created_at": { "type": ["string", "null"] },
          "pushed_at": { "type": ["string", "null"] },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "files_dir": { "description": "Local copy of the repo at `commit` (untrusted; never run).", "type": "string" },
          "hype": {
            "description": "Trending signals (see pick.schema.json). Null for the catalog source.",
            "type": ["object", "null"]
          },
          "skill_share": { "description": "Share of repo files inside skill folders, 0-1.", "type": "number" },
          "flags": { "description": "Repo-level notes, e.g. no license.", "type": "array", "items": { "type": "string" } },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["skill_id", "path", "has_page", "name", "description", "lines", "files", "status", "flags", "reasons"],
              "additionalProperties": false,
              "properties": {
                "skill_id": { "type": "string", "pattern": "^[^/]+/[^/]+/[^/]+$" },
                "path": { "description": "Skill folder in the repo; empty = root.", "type": "string" },
                "has_page": { "description": "Already has a page on surfskills.surf.", "type": ["boolean", "null"] },
                "name": { "type": ["string", "null"] },
                "description": { "type": ["string", "null"] },
                "lines": { "description": "Non-empty lines in the SKILL.md body.", "type": "integer" },
                "files": { "type": "integer" },
                "status": { "enum": ["pass", "fail"] },
                "flags": { "description": "Soft findings for the picker.", "type": "array", "items": { "type": "string" } },
                "reasons": { "description": "Hard-fail reasons; empty when status is pass.", "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "reason"],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
