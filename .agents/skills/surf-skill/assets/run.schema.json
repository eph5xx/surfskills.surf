{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run.json",
  "description": "What Run did and found. Written by run-review.mjs once the code checks pass and the AI review has a verdict.",
  "type": "object",
  "required": ["files", "agent", "duration_s", "turns", "timed_out", "questions", "images_generated", "hosts", "dropped_files", "checks", "shots", "review"],
  "additionalProperties": false,
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["verdict", "reason"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "enum": ["pass", "fail"] },
        "reason": { "type": "string" }
      }
    }
  },
  "properties": {
    "files": {
      "description": "Result files copied out of the workspace.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^result/" }
    },
    "agent": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["agy"] },
        "version": { "type": "string" }
      }
    },
    "duration_s": { "type": "integer", "minimum": 0 },
    "turns": { "description": "Agent turns, including answered questions and the nudge.", "type": "integer", "minimum": 1 },
    "timed_out": { "description": "The agent was stopped at the 10-minute limit after writing the deliverable.", "type": "boolean" },
    "questions": {
      "description": "Questions the agent asked and the stand-in's answers.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "images_generated": { "description": "Images agy's built-in image tool made.", "type": "integer", "minimum": 0 },
    "hosts": {
      "type": "object",
      "required": ["allowed", "denied"],
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string" } },
        "denied": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dropped_files": {
      "description": "Files in the workspace's result/ that the copy-out rules left behind.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "checks": {
      "description": "The plan's done checks and their outcome.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check", "path", "pass", "detail"],
        "additionalProperties": false,
        "properties": {
          "check": { "enum": ["exists", "contains", "differs", "min_bytes", "valid_html"] },
          "path": { "type": "string", "pattern": "^result/" },
          "value": { "type": ["string", "integer"] },
          "pass": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "shots": {
      "description": "Screenshots or images the reviewer saw.",
      "type": "array",
      "items": { "type": "string", "pattern": "^review/shots/" }
    },
    "review": {
      "type": "object",
      "required": ["verdict", "task_done", "not_broken", "skill_used", "video_ready", "summary"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "description": "ok when all four criteria pass, else bad.", "enum": ["ok", "bad"] },
        "task_done": { "$ref": "#/$defs/criterion" },
        "not_broken": { "$ref": "#/$defs/criterion" },
        "skill_used": { "$ref": "#/$defs/criterion" },
        "video_ready": { "$ref": "#/$defs/criterion" },
        "summary": { "type": "string" }
      }
    }
  }
}
