# Build-time values, inlined by Vite into both the server bundle and browser
# islands. Safe to expose: the publishable key is designed for the client.
# Find both under Supabase Dashboard → Settings → API.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# PostHog → Project Settings → Project API key (phc_…). Browser-safe; same
# value as POSTHOG_API_KEY in .dev.vars for server-side capture.
PUBLIC_POSTHOG_KEY=phc_...
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
